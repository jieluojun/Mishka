+// AddSafePath adds an application-owned directory to the path allowlist.
+// SAFE_PATHS is read when this package initializes, so embedded callers need
+// this runtime API when they create a private staging directory later.
+func AddSafePath(root string) error {
+	root = strings.TrimSpace(root)
+	if root == "" {
+		return fmt.Errorf("safe path is empty")
+	}
+	root, err := filepath.Abs(root)
+	if err != nil {
+		return fmt.Errorf("resolve safe path: %w", err)
+	}
+	root = filepath.Clean(root)
+
+	safePathsMu.Lock()
+	defer safePathsMu.Unlock()
+	for _, existing := range Path.safePaths {
+		if filepath.Clean(existing) == root {
+			return nil
+		}
+	}
+	Path.safePaths = append(Path.safePaths, root)
+	return nil
+}
+
 func (p *path) HomeDir() string {
 	return p.homeDir
 }
