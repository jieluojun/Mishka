From 5b61762c23e80dab13bf2c41c4de2f32c4f585e3 Mon Sep 17 00:00:00 2001
From: Mishka Custom Build <custom@localhost>
Date: Thu, 1 Oct 2026 09:40:03 +0000
Subject: [PATCH] sing_tun: make the android rule builder usable in mishka
 builds

The Mishka app builds mihomo with the cmfa tag (GoBuildTask tags:
cmfa,mishka,with_gvisor). On upstream, `cmfa` swaps the android
server_android.go out for the notandroid stub and turns the
uid -> package-name resolver off, because CFM's own Android app injects
package names differently.

Port YuKongA's mishka tag (2b7de8f): the android file is now selected when
`mishka` is set, and in that case the resolver is installed
unconditionally. `buildAndroidRules` also skips work for fd-based tun
(VpnService) and when no package filter was configured at all.

https://github.com/YuKongA/mihomo/commit/2b7de8f
---
 listener/sing_tun/server_android.go    | 18 +++++++++++++-----
 listener/sing_tun/server_notandroid.go |  2 +-
 2 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/listener/sing_tun/server_android.go b/listener/sing_tun/server_android.go
index fac3bbfb..a629a80f 100644
--- a/listener/sing_tun/server_android.go
+++ b/listener/sing_tun/server_android.go
@@ -1,4 +1,4 @@
-//go:build android && !cmfa
+//go:build android && (!cmfa || mishka)
 
 package sing_tun
 
@@ -8,7 +8,6 @@ import (
 
 	"github.com/metacubex/mihomo/component/process"
 	"github.com/metacubex/mihomo/constant"
-	"github.com/metacubex/mihomo/constant/features"
 	"github.com/metacubex/mihomo/log"
 
 	"github.com/metacubex/sing-tun"
@@ -54,6 +53,14 @@ func GetPackageManager() (tun.PackageManager, error) {
 }
 
 func (l *Listener) buildAndroidRules(tunOptions *tun.Options) error {
+	// TUN handed in as an fd (Android VpnService) already has its routes set up by the Kotlin
+	// side, so sing-tun must not build them again; package filtering is done by the VPN builder.
+	if tunOptions.FileDescriptor > 0 {
+		return nil
+	}
+	if len(tunOptions.IncludePackage) == 0 && len(tunOptions.ExcludePackage) == 0 {
+		return nil
+	}
 	packageManager, err := getPackageManager()
 	if err != nil {
 		return err
@@ -78,7 +85,8 @@ func findPackageName(metadata *constant.Metadata) (string, error) {
 }
 
 func init() {
-	if !features.CMFA {
-		process.DefaultPackageNameResolver = findPackageName
-	}
+	// Mishka always wants the uid -> package-name resolver: rules match on process names and
+	// the app does not use CMFA's package-name injection, which is why features.CMFA used to
+	// gate this off under the cmfa build tag.
+	process.DefaultPackageNameResolver = findPackageName
 }
diff --git a/listener/sing_tun/server_notandroid.go b/listener/sing_tun/server_notandroid.go
index e393d4ca..6cf9023b 100644
--- a/listener/sing_tun/server_notandroid.go
+++ b/listener/sing_tun/server_notandroid.go
@@ -1,4 +1,4 @@
-//go:build !android || cmfa
+//go:build !android || (cmfa && !mishka)
 
 package sing_tun
 
