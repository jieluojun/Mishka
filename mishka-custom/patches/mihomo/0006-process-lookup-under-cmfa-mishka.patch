From a142580592610d9d5d134b0becc25b9c360ceb02 Mon Sep 17 00:00:00 2001
From: Mishka Custom Build <custom@localhost>
Date: Thu, 8 Oct 2026 01:41:26 +0000
Subject: [PATCH] tunnel: resolve the process under the cmfa tag in mishka
 builds

Mishka builds carry the cmfa tag (Android system-DNS feed, embed mode,
loopback-detector off), so `features.CMFA` is true and
`resolveMetadata`'s FindProcess takes the CMFA-only branch. That branch
calls `process.FindPackageName(metadata)` directly, but the only place
in the tree that ever assigns `metadata.Uid` is the sibling branch it
skips -- so the resolver installed by the mishka tag
(server_android.go) always receives uid 0, returns "package not found",
and `metadata.Process` stays empty. Every PROCESS-NAME / PROCESS-PATH /
UID rule then silently never matches no matter what
`find-process-mode` says; the setting only decides whether this lookup
runs at all.

Take the normal lookup path in mishka builds too. It fills Uid /
Process / ProcessPath from the socket owner (netlink INET_DIAG with the
existing /proc/net and by-UID fallbacks) and then lets the Android
resolver replace the process name with the owning package name -- the
behaviour the mishka tag already asked for. Non-mishka cmfa builds keep
the CMFA branch unchanged; the stub keeps `features.Mishka` false there
and the tag is reported alongside the others.
---
 constant/features/mishka.go      |  5 +++++
 constant/features/mishka_stub.go |  5 +++++
 constant/features/tags.go        |  3 +++
 tunnel/tunnel.go                 | 10 +++++++++-
 4 files changed, 22 insertions(+), 1 deletion(-)
 create mode 100644 constant/features/mishka.go
 create mode 100644 constant/features/mishka_stub.go

diff --git a/constant/features/mishka.go b/constant/features/mishka.go
new file mode 100644
index 0000000..4e9b01b
--- /dev/null
+++ b/constant/features/mishka.go
@@ -0,0 +1,5 @@
+//go:build mishka
+
+package features
+
+const Mishka = true
diff --git a/constant/features/mishka_stub.go b/constant/features/mishka_stub.go
new file mode 100644
index 0000000..2ffbb37
--- /dev/null
+++ b/constant/features/mishka_stub.go
@@ -0,0 +1,5 @@
+//go:build !mishka
+
+package features
+
+const Mishka = false
diff --git a/constant/features/tags.go b/constant/features/tags.go
index 3af7086..2b32ae9 100644
--- a/constant/features/tags.go
+++ b/constant/features/tags.go
@@ -4,6 +4,9 @@ func Tags() (tags []string) {
 	if CMFA {
 		tags = append(tags, "cmfa")
 	}
+	if Mishka {
+		tags = append(tags, "mishka")
+	}
 	if WithLowMemory {
 		tags = append(tags, "with_low_memory")
 	}
diff --git a/tunnel/tunnel.go b/tunnel/tunnel.go
index a8b3a07..6002159 100644
--- a/tunnel/tunnel.go
+++ b/tunnel/tunnel.go
@@ -411,7 +411,15 @@ func resolveMetadata(metadata *C.Metadata) (proxy C.Proxy, rule C.Rule, decidedM
 		FindProcess: func() {
 			if attemptProcessLookup {
 				attemptProcessLookup = false
-				if !features.CMFA {
+				// Mishka builds carry the cmfa tag (for the Android system-DNS feed and
+				// embed mode) but do not inject package names the way CFM's app does.
+				// The CMFA-only branch below keys off metadata.Uid, which nothing else
+				// ever assigns, so under cmfa the resolver always sees uid 0 and every
+				// PROCESS/UID rule silently never matches. Take the normal lookup path
+				// instead: it fills Uid / Process / ProcessPath from the socket owner
+				// and then lets the Android resolver (server_android.go) replace the
+				// process name with the owning package name.
+				if !features.CMFA || features.Mishka {
 					// normal check for process
 					uid, path, err := findProcessName(metadata.NetWork.String(), metadata.SrcIP, int(metadata.SrcPort))
 					// On Linux the uid is the socket's owner from netlink, and the
