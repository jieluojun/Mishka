From 1caa0eb5e05af6ae59a22864cdaa31d195f4055a Mon Sep 17 00:00:00 2001
From: Mishka Custom Build <custom@localhost>
Date: Thu, 8 Oct 2026 13:00:00 +0000
Subject: [PATCH] config: rewrite unsafe provider paths into HomeDir for Mishka import check

Mishka's import flow writes absolute cache paths like
<mihomo>/processing/providers/<hash> into proxy-providers / rule-providers
of the generated config. The core's IsSafePath check only allows HomeDir
(the geodata directory during import validation) and SAFE_PATHS, so importing
such a config fails with "path is not subpath of home directory or SAFE_PATHS".

In patchMishka (which runs before ParseRawConfig parses providers), rewrite
any provider path that is not safe into a HomeDir-relative
"providers/<kind>/<basename>" location. The rewritten path resolves inside
HomeDir both at import-check time and at runtime; http providers re-download
into the new location when the cache file is absent. Providers with an
already-safe path are left untouched.

---
 config/patch_mishka.go | 48 ++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/config/patch_mishka.go b/config/patch_mishka.go
index 7a42efd..e5205fd 100644
--- a/config/patch_mishka.go
+++ b/config/patch_mishka.go
@@ -3,6 +3,8 @@
 package config
 
 import (
+	"path/filepath"
+
 	C "github.com/metacubex/mihomo/constant"
 )
 
@@ -69,7 +71,19 @@ func init() {
 //     external-ui: "ui" (plus a gh-proxy mirrored download URL if the stock
 //     default is still in place) so the in-app external panel WebView has
 //     something to serve at /ui instead of a bare 404.
+//   - Rewrite provider "path" entries that fall outside the safe paths into a
+//     HomeDir-relative location, so configs generated by Mishka's import flow
+//     (which point at <mihomo>/processing/providers/<hash>) pass the core's
+//     IsSafePath check during import validation.
 func patchMishka(cfg *RawConfig) {
+	// 导入校验修复：Mishka 导入配置时会把订阅缓存的绝对路径
+	// （<mihomo>/processing/providers/<hash> 等处理目录）写进 provider 的 path，
+	// 而内核只允许 HomeDir（导入校验时是 geodata 目录）与 SAFE_PATHS 内的路径，
+	// 结果报 "path is not subpath of home directory or SAFE_PATHS" 校验失败。
+	// 在 ParseRawConfig 解析 provider 之前重写掉这些 path。
+	rewriteUnsafeProviderPaths(cfg.ProxyProvider, "proxies")
+	rewriteUnsafeProviderPaths(cfg.RuleProvider, "rules")
+
 	if !cfg.DNS.Enable {
 		cfg.DNS = DefaultRawConfig().DNS
 		cfg.DNS.Enable = true
@@ -116,3 +130,37 @@ func patchMishka(cfg *RawConfig) {
 		}
 	}
 }
+
+// rewriteUnsafeProviderPaths rewrites provider "path" entries that fall outside
+// the safe paths into a HomeDir-relative location.
+//
+// Mishka's import flow materialises subscription caches under
+// <mihomo>/processing/providers/<hash> (and similar processing directories) and
+// writes those absolute paths into the generated config's proxy-providers /
+// rule-providers. The core only accepts paths inside HomeDir (during import
+// validation HomeDir is the geodata directory) or SAFE_PATHS, so importing such
+// a config fails with "path is not subpath of home directory or SAFE_PATHS".
+//
+// The rewritten path is relative ("providers/<kind>/<basename>"), so it resolves
+// inside HomeDir both at import-check time and at runtime. http providers whose
+// cache file is absent simply re-download into the new location; providers with
+// an already-safe path are left untouched.
+func rewriteUnsafeProviderPaths(providers map[string]map[string]any, kind string) {
+	for name, provider := range providers {
+		if len(provider) == 0 {
+			continue
+		}
+		path, ok := provider["path"].(string)
+		if !ok || path == "" {
+			continue
+		}
+		if C.Path.IsSafePath(path) {
+			continue
+		}
+		base := filepath.Base(C.Path.Resolve(path))
+		if base == "" || base == "." || base == string(filepath.Separator) {
+			base = name
+		}
+		provider["path"] = filepath.Join("providers", kind, base)
+	}
+}
