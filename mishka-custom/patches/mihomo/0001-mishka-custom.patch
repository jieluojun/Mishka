From: Mishka 定制移植 <noreply@mishka.local>
Subject: [PATCH] mishka 定制合并补丁（原 0001..0007）

把 YuKongA/Mishka 的内核定制合并成单个补丁，内容与拆分的 7 个补丁逐一等价：
应用后的树哈希必须等于 BASELINE.txt 的 patched_tree。

  0001 config: 支持 --override-json，JSON 覆盖 YAML（不出现的键保留 YAML 值）
  0002 sing_tun: 构建标签放宽到 android && (!cmfa || mishka)，注册
         process.DefaultPackageNameResolver；fd 模式（非 root）跳过 buildAndroidRules
  0003 config: patch_mishka.go —— DNS 默认值，fd 模式追加系统 DNS
  0004 sing_tun: forwarderBindInterface = true
  0005 eBPF listener 变 no-op 桩：编得进、起得来，但不填充规则元数据
  0006 constant/features: 新增 features.Mishka；tunnel.go 分支条件改为
         !features.CMFA || features.Mishka，让 cmfa 构建也走正常进程查询
  0007 component/process: ConnectionOwnerResolver 挂钩 + uid-oracle unix socket
         客户端；tunnel.go 在 metadata.Uid == 0 时兜底查询 —— 让无 root 的
         VPN 模式也能匹配 PROCESS-NAME / PROCESS-PATH / UID

校验：tools/verify_mihomo_patches.sh --kernel-dir <fc45379e 的干净 clone>

---
diff --git a/component/process/connection_owner.go b/component/process/connection_owner.go
new file mode 100644
index 00000000..f5493fcc
--- /dev/null
+++ b/component/process/connection_owner.go
@@ -0,0 +1,30 @@
+package process
+
+import (
+	C "github.com/metacubex/mihomo/constant"
+)
+
+// ConnectionOwnerResolver answers "which UID owns this connection, and what
+// should rules call it" for hosts where the kernel cannot tell us. An
+// unprivileged Android VpnService is the case in point: /proc/net and
+// NETLINK_INET_DIAG are closed to it, so findProcessName always comes back
+// empty, yet the platform hands the same answer to the active VPN through
+// ConnectivityManager.getConnectionOwnerUid.
+//
+// Implementations must be safe for concurrent use (routing calls this from
+// arbitrary goroutines) and must fail fast: returning an error is cheap,
+// blocking the tunnel is not.
+type ConnectionOwnerResolver func(metadata *C.Metadata) (uid uint32, name string, err error)
+
+// DefaultConnectionOwnerResolver is nil unless the platform provides one.
+var DefaultConnectionOwnerResolver ConnectionOwnerResolver
+
+// FindConnectionOwner asks the host who owns this connection. The returned name
+// is what PROCESS-NAME rules match on -- on Android that is the package name,
+// not a process title.
+func FindConnectionOwner(metadata *C.Metadata) (uint32, string, error) {
+	if resolver := DefaultConnectionOwnerResolver; resolver != nil {
+		return resolver(metadata)
+	}
+	return 0, "", ErrPlatformNotSupport
+}
diff --git a/component/process/uid_oracle_mishka.go b/component/process/uid_oracle_mishka.go
new file mode 100644
index 00000000..ff3c2db8
--- /dev/null
+++ b/component/process/uid_oracle_mishka.go
@@ -0,0 +1,136 @@
+//go:build mishka
+
+package process
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+// UidOracleSocketName is the unix socket the Mishka app serves connection
+// ownership from, inside the core's working directory (`-d`). The app only
+// creates it in VPN mode: under ROOT the core is uid 0 and answers from
+// netlink/procfs itself, so the socket is absent and every lookup below costs
+// one stat.
+//
+// Filesystem namespace, not abstract: the work dir is 0700 and owned by the
+// app's UID, so no other app on the device can ask who owns whose sockets.
+const UidOracleSocketName = "uid-oracle.sock"
+
+// uidOracleTimeout bounds one round trip. The app answers with a binder call to
+// ConnectivityService plus a PackageManager lookup; both are sub-millisecond
+// when healthy, and a slow answer must not stall the tunnel.
+const uidOracleTimeout = 500 * time.Millisecond
+
+// A dead or wedged oracle must not be paid for on every connection. After this
+// many consecutive transport failures we stop asking for a while; a valid
+// answer (including "nobody owns this") resets the count, so a genuinely absent
+// owner is never mistaken for a broken oracle.
+const (
+	oracleFailureThreshold = 8
+	oracleCooldown         = 5 * time.Second
+)
+
+var (
+	oracleFailures   atomic.Int32
+	oracleDisabledAt atomic.Int64 // unix nano
+)
+
+func init() {
+	DefaultConnectionOwnerResolver = findConnectionOwnerViaOracle
+}
+
+// findConnectionOwnerViaOracle asks the host app over a unix socket.
+//
+// Wire format, one line each way, no framing beyond the newline:
+//
+//	request  "<tcp|udp>|<srcIP>|<srcPort>|<dstIP>|<dstPort>"
+//	response "<uid>\t<packageName>"
+//
+// The destination is sent exactly as routing sees it: under fake-ip that is the
+// fake address, which is what the owning app's socket really is connected to,
+// so the app-side inet_diag lookup still matches.
+func findConnectionOwnerViaOracle(metadata *C.Metadata) (uint32, string, error) {
+	line, err := askOracle(metadata)
+	if err != nil {
+		if errors.Is(err, ErrPlatformNotSupport) || errors.Is(err, ErrInvalidNetwork) {
+			return 0, "", err
+		}
+		if n := oracleFailures.Add(1); n >= oracleFailureThreshold {
+			oracleDisabledAt.Store(time.Now().Add(oracleCooldown).UnixNano())
+			oracleFailures.Store(0)
+		}
+		return 0, "", err
+	}
+	oracleFailures.Store(0)
+	return parseOracleResponse(line)
+}
+
+func askOracle(metadata *C.Metadata) (string, error) {
+	if metadata == nil {
+		return "", ErrInvalidNetwork
+	}
+	if !metadata.SrcIP.IsValid() || !metadata.DstIP.IsValid() {
+		return "", ErrInvalidNetwork
+	}
+	if time.Now().UnixNano() < oracleDisabledAt.Load() {
+		return "", ErrPlatformNotSupport
+	}
+	socketPath := C.Path.Resolve(UidOracleSocketName)
+	if _, err := os.Stat(socketPath); err != nil {
+		return "", ErrPlatformNotSupport
+	}
+
+	conn, err := net.DialTimeout("unix", socketPath, uidOracleTimeout)
+	if err != nil {
+		return "", fmt.Errorf("uid oracle: dial: %w", err)
+	}
+	defer conn.Close()
+	if err = conn.SetDeadline(time.Now().Add(uidOracleTimeout)); err != nil {
+		return "", fmt.Errorf("uid oracle: deadline: %w", err)
+	}
+
+	request := strings.Join([]string{
+		metadata.NetWork.String(),
+		metadata.SrcIP.String(),
+		strconv.Itoa(int(metadata.SrcPort)),
+		metadata.DstIP.String(),
+		strconv.Itoa(int(metadata.DstPort)),
+	}, "|")
+	if _, err = io.WriteString(conn, request+"\n"); err != nil {
+		return "", fmt.Errorf("uid oracle: write: %w", err)
+	}
+	line, err := bufio.NewReader(conn).ReadString('\n')
+	if err != nil && line == "" {
+		return "", fmt.Errorf("uid oracle: read: %w", err)
+	}
+	return line, nil
+}
+
+func parseOracleResponse(line string) (uint32, string, error) {
+	uidText, name, found := strings.Cut(strings.TrimSpace(line), "\t")
+	if !found {
+		return 0, "", fmt.Errorf("uid oracle: malformed response %q", line)
+	}
+	uid, err := strconv.ParseUint(uidText, 10, 32)
+	if err != nil {
+		return 0, "", fmt.Errorf("uid oracle: bad uid %q", uidText)
+	}
+	if uid == 0 {
+		return 0, "", errors.New("uid oracle: connection has no owner")
+	}
+	if name == "" {
+		return 0, "", fmt.Errorf("uid oracle: missing name for uid %s", uidText)
+	}
+	return uint32(uid), name, nil
+}
diff --git a/component/process/uid_oracle_mishka_test.go b/component/process/uid_oracle_mishka_test.go
new file mode 100644
index 00000000..c2d2f5b7
--- /dev/null
+++ b/component/process/uid_oracle_mishka_test.go
@@ -0,0 +1,195 @@
+//go:build mishka
+
+package process
+
+import (
+	"net"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestParseOracleResponse(t *testing.T) {
+	uid, name, err := parseOracleResponse("10233\tcom.android.chrome\n")
+	if err != nil || uid != 10233 || name != "com.android.chrome" {
+		t.Fatalf("parse = %d, %q, %v", uid, name, err)
+	}
+	for _, bad := range []string{"", "\n", "10233\n", "abc\tcom.x\n", "0\tcom.x\n", "10233\t\n"} {
+		if _, _, err := parseOracleResponse(bad); err == nil {
+			t.Fatalf("parseOracleResponse(%q) should fail", bad)
+		}
+	}
+}
+
+// A missing oracle socket must be a cheap, silent "not supported": ROOT modes
+// never run one, and this sits on the per-connection path.
+func TestOracleAbsentIsPlatformNotSupport(t *testing.T) {
+	restore := withHomeDir(t)
+	defer restore()
+
+	if _, err := os.Lstat(filepath.Join(C.Path.HomeDir(), UidOracleSocketName)); !os.IsNotExist(err) {
+		t.Fatalf("precondition: socket should not exist, got %v", err)
+	}
+	if _, _, err := findConnectionOwnerViaOracle(testMetadata()); err != ErrPlatformNotSupport {
+		t.Fatalf("err = %v, want ErrPlatformNotSupport", err)
+	}
+}
+
+// End to end over a real unix socket: the request carries the 5-tuple routing
+// saw (including a fake-ip destination), and the reply becomes the UID plus the
+// name PROCESS-NAME rules match on.
+func TestOracleRoundTrip(t *testing.T) {
+	restore := withHomeDir(t)
+	defer restore()
+
+	listener, err := net.Listen("unix", filepath.Join(C.Path.HomeDir(), UidOracleSocketName))
+	if err != nil {
+		t.Fatalf("listen: %v", err)
+	}
+	defer listener.Close()
+
+	type result struct {
+		request string
+	}
+	got := make(chan result, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			got <- result{}
+			return
+		}
+		defer conn.Close()
+		buf := make([]byte, 256)
+		n, _ := conn.Read(buf)
+		got <- result{request: string(buf[:n])}
+		_, _ = conn.Write([]byte("10456\tcom.tencent.mm\n"))
+	}()
+
+	uid, name, err := findConnectionOwnerViaOracle(testMetadata())
+	if err != nil {
+		t.Fatalf("lookup: %v", err)
+	}
+	if uid != 10456 || name != "com.tencent.mm" {
+		t.Fatalf("lookup = %d, %q", uid, name)
+	}
+	if request := (<-got).request; request != "tcp|192.168.1.24|41234|28.0.14.7|443\n" {
+		t.Fatalf("request = %q", request)
+	}
+}
+
+// A hung oracle must time out instead of pinning the tunnel.
+func TestOracleTimeout(t *testing.T) {
+	restore := withHomeDir(t)
+	defer restore()
+
+	listener, err := net.Listen("unix", filepath.Join(C.Path.HomeDir(), UidOracleSocketName))
+	if err != nil {
+		t.Fatalf("listen: %v", err)
+	}
+	defer listener.Close()
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		time.Sleep(2 * uidOracleTimeout) // accept, then never answer
+		_ = conn.Close()
+	}()
+
+	start := time.Now()
+	if _, _, err := findConnectionOwnerViaOracle(testMetadata()); err == nil {
+		t.Fatal("expected a timeout error")
+	}
+	if elapsed := time.Since(start); elapsed > 3*uidOracleTimeout {
+		t.Fatalf("lookup took %v, deadline not honoured", elapsed)
+	}
+}
+
+// Metadata without usable addresses must not reach the socket at all.
+func TestOracleRejectsIncompleteMetadata(t *testing.T) {
+	restore := withHomeDir(t)
+	defer restore()
+
+	metadata := testMetadata()
+	metadata.DstIP = netip.Addr{}
+	if _, _, err := findConnectionOwnerViaOracle(metadata); err != ErrInvalidNetwork {
+		t.Fatalf("err = %v, want ErrInvalidNetwork", err)
+	}
+	if _, _, err := findConnectionOwnerViaOracle(nil); err != ErrInvalidNetwork {
+		t.Fatalf("err = %v, want ErrInvalidNetwork", err)
+	}
+}
+
+// A wedged oracle must stop being asked for: every PROCESS/UID rule on every
+// connection would otherwise pay the timeout.
+func TestOracleCircuitBreaker(t *testing.T) {
+	restore := withHomeDir(t)
+	defer restore()
+	resetOracleState()
+
+	listener, err := net.Listen("unix", filepath.Join(C.Path.HomeDir(), UidOracleSocketName))
+	if err != nil {
+		t.Fatalf("listen: %v", err)
+	}
+	defer listener.Close()
+	// Accept and never answer: each call costs the full deadline.
+	for i := 0; i < oracleFailureThreshold+2; i++ {
+		go func() {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			time.Sleep(3 * uidOracleTimeout)
+			_ = conn.Close()
+		}()
+	}
+
+	for i := 0; i < oracleFailureThreshold; i++ {
+		if _, _, err := findConnectionOwnerViaOracle(testMetadata()); err == nil {
+			t.Fatalf("call %d: expected an error", i)
+		}
+	}
+	// Circuit is open now: the next call must bail immediately, not wait.
+	start := time.Now()
+	if _, _, err := findConnectionOwnerViaOracle(testMetadata()); err != ErrPlatformNotSupport {
+		t.Fatalf("err = %v, want ErrPlatformNotSupport while cooling down", err)
+	}
+	if elapsed := time.Since(start); elapsed > 50*time.Millisecond {
+		t.Fatalf("cooling-down call took %v", elapsed)
+	}
+
+	// A healthy answer clears the failure count for the next round.
+	resetOracleState()
+	if oracleFailures.Load() != 0 || oracleDisabledAt.Load() != 0 {
+		t.Fatal("resetOracleState did not clear the breaker")
+	}
+}
+
+func resetOracleState() {
+	oracleFailures.Store(0)
+	oracleDisabledAt.Store(0)
+}
+
+func testMetadata() *C.Metadata {
+	return &C.Metadata{
+		NetWork: C.TCP,
+		SrcIP:   netip.MustParseAddr("192.168.1.24"),
+		SrcPort: 41234,
+		DstIP:   netip.MustParseAddr("28.0.14.7"),
+		DstPort: 443,
+	}
+}
+
+// withHomeDir points the constant path resolver at a fresh temp dir. C.Path is
+// process-wide, so these tests must not run in parallel with each other.
+func withHomeDir(t *testing.T) func() {
+	t.Helper()
+	previous := C.Path.HomeDir()
+	C.SetHomeDir(t.TempDir())
+	t.Cleanup(func() { C.SetHomeDir(previous) })
+	return func() { C.SetHomeDir(previous) }
+}
