-    /** 当前是否为 ROOT eBPF 模式（此时系统 IPv6 不会被禁用）。 */
+    /**
+     * 活动配置的 eBPF 是否接管 IPv6：任一 ebpf 监听器的 local.ipv6 / shared.ipv6 不为 false。
+     * 与 mihomo 一致：未写 ipv6 视为开启；app 注入的默认监听器写的是 false。
+     * 配置读不到、解析失败或为 age 密文时保守返回 true（保持系统 IPv6 开启，与旧行为一致）。
+     */
+    fun ebpfTakesOverIpv6(context: Context): Boolean {
+        val subscriptionId = PlatformStorage(context).getString(StorageKeys.ROOT_ACTIVE_SUBSCRIPTION_ID, "").ifEmpty { null }
+        val file = if (subscriptionId == null) {
+            File(ConfigGenerator.getWorkDir(context), "config.yaml")
+        } else {
+            ProfileFileOps.getSubscriptionConfigFile(context, subscriptionId)
+        }
+        if (!file.isFile || file.length() == 0L) return true
+        return try {
+            val text = file.readText(Charsets.UTF_8)
+            if (text.trimStart().startsWith("-----BEGIN AGE ENCRYPTED FILE-----")) return true
+            val doc = YamlDoc.parse(text)
+            val listeners = doc.get(listOf("listeners"))
+            if (listeners == null || doc.isNullText(listeners)) return false
+            if (listeners.kind != YamlNode.Kind.SEQ) return true
+            val indices = listeners.items.indices.filter { index ->
+                FormValues.readRaw(doc, listOf("listeners", index, "type"))?.equals("ebpf", ignoreCase = true) == true
+            }
+            // 没有 ebpf 监听器时 app 会注入默认监听器（ipv6 = false），即不接管
+            indices.any { index ->
+                ipv6Allowed(FormValues.readRaw(doc, listOf("listeners", index, "local", "ipv6"))) ||
+                    ipv6Allowed(FormValues.readRaw(doc, listOf("listeners", index, "shared", "ipv6")))
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "ebpfTakesOverIpv6 failed, keep system IPv6 on: ${e.message}")
+            true
+        }
+    }
+
+    /** 未写或 null 视为开启（mihomo 内核默认）；只有显式 false 类值才视为不接管。 */
+    private fun ipv6Allowed(raw: String?): Boolean =
+        when (raw?.trim()?.lowercase()) {
+            "false", "no", "off", "0" -> false
+            else -> true
+        }
+
+    /** 当前是否为 ROOT eBPF 模式。 */
     fun isEbpfMode(context: Context): Boolean =
         PlatformStorage(context).getString(StorageKeys.TUN_MODE, "vpn") == "root_ebpf"
 
