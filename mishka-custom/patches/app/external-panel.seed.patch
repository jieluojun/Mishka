+package top.yukonga.mishka.ui.screen.panel
+
+import android.annotation.SuppressLint
+import android.webkit.WebResourceError
+import android.webkit.WebResourceRequest
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import androidx.activity.compose.BackHandler
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.graphicsLayer
+import androidx.compose.ui.platform.LocalLayoutDirection
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.LayoutDirection
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import androidx.compose.ui.viewinterop.AndroidView
+import top.yukonga.mishka.R
+import top.yukonga.mishka.ui.component.AdaptiveTopAppBar
+import top.yukonga.mishka.ui.component.blur.BlurredBar
+import top.yukonga.mishka.ui.component.blur.rememberBlurBackdrop
+import top.yukonga.miuix.kmp.basic.Icon
+import top.yukonga.miuix.kmp.basic.IconButton
+import top.yukonga.miuix.kmp.basic.MiuixScrollBehavior
+import top.yukonga.miuix.kmp.basic.Scaffold
+import top.yukonga.miuix.kmp.basic.Text
+import top.yukonga.miuix.kmp.icon.MiuixIcons
+import top.yukonga.miuix.kmp.icon.extended.Back
+import top.yukonga.miuix.kmp.theme.MiuixTheme
+
+/**
+ * 外部面板：应用内 WebView 打开内核 `external-ui` 提供的网页控制台（zashboard 等）。
+ *
+ * 地址由 [externalPanelUrl] 从运行态的 external-controller 推导（`/ui` 是 mihomo
+ * `external-ui-name` 的缺省挂载路径）。内核没在跑、或配置里没有 external-ui 时加载会失败，
+ * 页面中央给一句可操作的提示而不是白屏。
+ */
+@SuppressLint("SetJavaScriptEnabled")
+@Composable
+fun ExternalPanelScreen(
+    url: String,
+    onBack: () -> Unit = {},
+) {
+    val scrollBehavior = MiuixScrollBehavior()
+    val backdrop = rememberBlurBackdrop()
+    val blurActive = backdrop != null
+    val barColor = if (blurActive) Color.Transparent else MiuixTheme.colorScheme.surface
+
+    var webView by remember { mutableStateOf<WebView?>(null) }
+    // 系统返回优先在面板里回退历史，退无可退才离开页面
+    BackHandler {
+        val current = webView
+        if (current?.canGoBack() == true) current.goBack() else onBack()
+    }
+
+    var failed by remember(url) { mutableStateOf(false) }
+
+    Scaffold(
+        topBar = {
+            BlurredBar(backdrop = backdrop, blurActive = blurActive) {
+                AdaptiveTopAppBar(
+                    title = stringResource(R.string.home_external_panel),
+                    color = barColor,
+                    scrollBehavior = scrollBehavior,
+                    navigationIcon = {
+                        IconButton(onClick = onBack) {
+                            val layoutDirection = LocalLayoutDirection.current
+                            Icon(
+                                imageVector = MiuixIcons.Back,
+                                contentDescription = stringResource(R.string.common_back),
+                                tint = MiuixTheme.colorScheme.onSurface,
+                                modifier = Modifier.graphicsLayer {
+                                    scaleX = if (layoutDirection == LayoutDirection.Rtl) -1f else 1f
+                                },
+                            )
+                        }
+                    },
+                )
+            }
+        },
+    ) { innerPadding ->
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(top = innerPadding.calculateTopPadding()),
+        ) {
+            AndroidView(
+                factory = { context ->
+                    WebView(context).apply {
+                        // 面板是 SPA：JS 与 localStorage 都是硬需求
+                        settings.javaScriptEnabled = true
+                        settings.domStorageEnabled = true
+                        webViewClient = object : WebViewClient() {
+                            override fun onPageStarted(view: WebView?, url: String?, favicon: android.graphics.Bitmap?) {
+                                failed = false
+                            }
+
+                            override fun onReceivedError(
+                                view: WebView?,
+                                request: WebResourceRequest?,
+                                error: WebResourceError?,
+                            ) {
+                                // 只关心主文档：SPA 里个别子资源 404 不该把整页标成失败
+                                if (request?.isForMainFrame == true) failed = true
+                            }
+                        }
+                        loadUrl(url)
+                        webView = this
+                    }
+                },
+                onRelease = { view ->
+                    webView = null
+                    view.destroy()
+                },
+                modifier = Modifier.fillMaxSize(),
+            )
+            if (failed) {
+                Text(
+                    text = stringResource(R.string.external_panel_load_failed),
+                    fontSize = 13.sp,
+                    color = MiuixTheme.colorScheme.onSurfaceVariantSummary,
+                    modifier = Modifier
+                        .align(Alignment.Center)
+                        .padding(horizontal = 32.dp),
+                )
+            }
+        }
+    }
+}
+
+/**
+ * 运行中的 external-controller → 面板地址。`0.0.0.0` / `*` / `::` 是监听通配地址、不可连接，
+ * 换成本机回环；缺省端口按 mihomo 惯例不补（配置里 host:port 一体）。
+ */
+fun externalPanelUrl(externalController: String): String {
+    val raw = externalController.trim()
+        .removePrefix("http://")
+        .removePrefix("https://")
+        .substringBefore('/')
+    val host = raw.substringBeforeLast(':').ifEmpty { "127.0.0.1" }
+    val port = raw.substringAfterLast(':', "")
+    val reachableHost = if (host == "0.0.0.0" || host == "*" || host == "::" || host == "[::]") {
+        "127.0.0.1"
+    } else {
+        host
+    }
+    return if (port.isEmpty()) "http://$reachableHost/ui" else "http://$reachableHost:$port/ui"
+}
