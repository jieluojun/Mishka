+package top.yukonga.mishka.ui.screen.panel
+
+import android.app.Activity
+import android.app.AlertDialog
+import android.content.ClipData
+import android.content.ClipboardManager
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.os.Bundle
+import android.view.View
+import android.webkit.ConsoleMessage
+import android.webkit.WebChromeClient
+import android.webkit.WebResourceError
+import android.webkit.WebResourceRequest
+import android.webkit.WebResourceResponse
+import android.webkit.WebSettings
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import android.window.OnBackInvokedCallback
+import android.window.OnBackInvokedDispatcher
+import android.widget.ScrollView
+import android.widget.TextView
+import top.yukonga.mishka.R
+import top.yukonga.mishka.platform.PlatformStorage
+import top.yukonga.mishka.platform.ProxyServiceBridge
+import top.yukonga.mishka.platform.StorageKeys
+import top.yukonga.mishka.service.StartDiag
+
+/**
+ * 外部面板（r10 重做）：**传统 View 宿主**的独立 Activity——BoxProxy 式实现。
+ *
+ * 为什么换宿主：设备实证（r6–r9 探针 + BoxProxy 对照截图）——同一设备同一 WebView 引擎，
+ * BoxProxy 的传统 View WebView 完整渲染 zashboard，而 Mishka 原来把 WebView 放进 Compose
+ * `AndroidView` interop 容器后出现「dvh 解析为 0 → 高度链塌陷」与「几何全对但文档层不绘制」
+ * 两个症状；二者都是 interop 渲染路径缺陷的表现。本 Activity 让 WebView 生活在纯 View 树里
+ * （XML 布局直接声明），Compose 完全不参与渲染路径；顶栏改为 BoxProxy 同款：
+ * 返回 + `host:port | 路由` 标题 + 刷新 / 诊断 / 清缓存重载 三个图标（去掉「外部面板」大标题）。
+ *
+ * 保留 r3–r9 的全部防线（坏引擎上仍是双保险）：console/网络错误诊断环、布局探针、
+ * dvh 像素修复注入（[DVH_FIX_JS]，好引擎 not-needed 零干预）、resize/scroll 补发、
+ * 本地面板禁 HTTP 缓存、首次非零布局后再加载；诊断抽屉由顶栏「调节」图标打开，
+ * 内含复制 / 浏览器打开 / 关闭。
+ */
+class ExternalPanelActivity : Activity() {
+
+    private lateinit var web: WebView
+    private lateinit var titleView: TextView
+    private val diag = PanelDiagLog()
+    private var loadedOnce = false
+    private var baseTitle = ""
+
+    /** 返回语义统一在这里：WebView 有历史先回退网页，否则关闭面板页。 */
+    private fun panelBack() {
+        if (web.canGoBack()) web.goBack() else finish()
+    }
+
+    /** targetSdk 35+ 不再回调 onBackPressed()：API 33+ 必须走 OnBackInvokedCallback。 */
+    private val backInvokedCallback = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+        OnBackInvokedCallback { panelBack() }
+    } else {
+        null
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_external_panel)
+        web = findViewById(R.id.panel_web)
+        val cb = backInvokedCallback
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU && cb != null) {
+            onBackInvokedDispatcher.registerOnBackInvokedCallback(
+                OnBackInvokedDispatcher.PRIORITY_DEFAULT,
+                cb,
+            )
+        }
+        titleView = findViewById(R.id.panel_title)
+        val url = intent.getStringExtra(EXTRA_URL).orEmpty()
+        // r10 二轮修正：面板 URL 的 host/port 在 **query** 里（zashboard.pages.dev 只是载体），
+        // 上一版误从 authority 取 → 顶栏显示成域名；改从 query 参数还原真实控制器地址。
+        baseTitle = runCatching {
+            val u = Uri.parse(url)
+            val h = u.getQueryParameter("host") ?: u.host.orEmpty()
+            val qport = u.getQueryParameter("port")
+            if (!qport.isNullOrEmpty()) "$h:$qport" else h
+        }.getOrDefault("")
+        titleView.text = baseTitle
+
+        findViewById<View>(R.id.panel_back).setOnClickListener { panelBack() }
+        findViewById<View>(R.id.panel_refresh).setOnClickListener { web.reload() }
+        findViewById<View>(R.id.panel_tune).setOnClickListener { showDiag() }
+        findViewById<View>(R.id.panel_delete).setOnClickListener {
+            web.clearCache(true)
+            web.reload()
+        }
+
+        // 面板是 SPA：JS 与 localStorage 都是硬需求；本地 UI 禁缓存避免坏副本复现
+        web.settings.javaScriptEnabled = true
+        web.settings.domStorageEnabled = true
+        web.settings.cacheMode = WebSettings.LOAD_NO_CACHE
+        // r12：zashboard「更新面板」等按钮可能触发下载流；无 DownloadListener 时 WebView
+        // 静默丢弃 → 「点了没反应」。交给外部浏览器处理。
+        web.setDownloadListener { dlUrl, _, _, _, _ ->
+            diag.add("[download] $dlUrl")
+            runCatching {
+                startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(dlUrl)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+            }
+        }
+        web.webChromeClient = object : WebChromeClient() {
+            override fun onConsoleMessage(message: ConsoleMessage?): Boolean {
+                message?.let {
+                    diag.add("[console:${it.messageLevel()}] ${it.message()} @${it.sourceId()}:${it.lineNumber()}")
+                }
+                return true
+            }
+        }
+        web.webViewClient = object : WebViewClient() {
+            override fun onPageStarted(view: WebView?, pageUrl: String?, favicon: android.graphics.Bitmap?) {
+                diag.add("[page] started $pageUrl")
+            }
+
+            override fun onReceivedError(view: WebView?, request: WebResourceRequest?, error: WebResourceError?) {
+                diag.add("[neterr main=${request?.isForMainFrame == true}] ${error?.errorCode} ${error?.description} ${request?.url}")
+            }
+
+            override fun onReceivedHttpError(
+                view: WebView?,
+                request: WebResourceRequest?,
+                errorResponse: WebResourceResponse?,
+            ) {
+                diag.add("[httperr ${errorResponse?.statusCode} main=${request?.isForMainFrame == true}] ${request?.url}")
+            }
+
+            override fun onPageFinished(view: WebView?, pageUrl: String?) {
+                diag.add("[page] finished $pageUrl")
+                updateTitle(pageUrl)
+                view?.postDelayed({ fixDvh(view, diag) }, 400)
+                view?.postDelayed({ fixDvh(view, diag) }, 1500)
+                view?.postDelayed({ fixDvh(view, diag) }, 4000)
+                view?.postDelayed({ nudgeResize(view, diag) }, 600)
+                view?.postDelayed({ runProbe(view, diag, 1) }, 2500)
+                view?.postDelayed({ runProbe(view, diag, 2) }, 8000)
+            }
+        }
+        // 传统宿主下首帧布局通常已正确；保留「非零布局后加载」防线（幂等、无副作用）
+        web.addOnLayoutChangeListener(object : View.OnLayoutChangeListener {
+            private var lastH = -1
+            override fun onLayoutChange(
+                v: View,
+                left: Int, top: Int, right: Int, bottom: Int,
+                oldLeft: Int, oldTop: Int, oldRight: Int, oldBottom: Int,
+            ) {
+                if (v.width == 0 || v.height == 0) return
+                if (!loadedOnce) {
+                    loadedOnce = true
+                    lastH = v.height
+                    diag.add("[layout] first non-zero ${v.width}x${v.height}, loading")
+                    v.post { web.loadUrl(url) }
+                    return
+                }
+                if (v.height != lastH) {
+                    lastH = v.height
+                    v.post { nudgeResize(web, diag) }
+                }
+            }
+        })
+    }
+
+    /** 顶栏标题 = `host:port | 路由名`（与 BoxProxy 一致），路由从 hash 推导。 */
+    private fun updateTitle(pageUrl: String?) {
+        val route = pageUrl?.substringAfter('#', "")?.trimStart('/').orEmpty().substringBefore('/')
+        val res = when (route) {
+            "" -> R.string.external_panel_route_overview
+            "proxies" -> R.string.external_panel_route_proxies
+            "connections" -> R.string.external_panel_route_connections
+            "logs" -> R.string.external_panel_route_logs
+            "rules" -> R.string.external_panel_route_rules
+            "settings" -> R.string.external_panel_route_settings
+            else -> null
+        }
+        val routeName = res?.let { getString(it) }.orEmpty()
+        titleView.text = if (routeName.isEmpty()) baseTitle else "$baseTitle | $routeName"
+    }
+
+    private fun showDiag() {
+        val text = TextView(this).apply {
+            text = StartDiag.text() + "\n---- panel ----\n" + diag.text()
+            setTextSize(android.util.TypedValue.COMPLEX_UNIT_SP, 11f)
+            setTextIsSelectable(true)
+            setPadding(48, 24, 48, 24)
+        }
+        val scroll = ScrollView(this).apply { addView(text) }
+        AlertDialog.Builder(this)
+            .setTitle(R.string.external_panel_diag_title)
+            .setView(scroll)
+            .setPositiveButton(R.string.external_panel_diag_copy) { _, _ ->
+                val cm = getSystemService(ClipboardManager::class.java)
+                cm.setPrimaryClip(ClipData.newPlainText("mishka-panel-diag", diag.text()))
+            }
+            .setNeutralButton(R.string.external_panel_diag_open_browser) { _, _ ->
+                runCatching {
+                    startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(intent.getStringExtra(EXTRA_URL).orEmpty()))
+                        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+                }
+            }
+            .setNegativeButton(R.string.external_panel_diag_close, null)
+            .show()
+    }
+
+    @Suppress("DEPRECATION")
+    override fun onBackPressed() {
+        // API 31–32（未注册 OnBackInvokedCallback 的旧路径）；33+ 由 backInvokedCallback 接管
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) panelBack() else super.onBackPressed()
+    }
+
+    override fun onDestroy() {
+        // 局部 val 承接：成员属性的可空 smart cast 不跨 lambda 边界（CI 编译错误 204:83）
+        val cb = backInvokedCallback
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU && cb != null) {
+            runCatching { onBackInvokedDispatcher.unregisterOnBackInvokedCallback(cb) }
+        }
+        super.onDestroy()
+    }
+
+    companion object {
+        const val EXTRA_URL = "mishka_panel_url"
+    }
+}
+
+/**
+ * r12：面板 URL 的地址源 = 最近一次**实际启动尝试**的 ext-ctl/secret（持久化），
+ * 桥接 state 兜底。修「启动失败后 state 留默认 127.0.0.1:9090 → 面板连到占用者」的误导。
+ */
+fun externalPanelUrlFrom(context: android.content.Context): String {
+    val storage = PlatformStorage(context)
+    val state = ProxyServiceBridge.state.value
+    val ec = storage.getString(StorageKeys.PANEL_LAST_EXT_CTL, "")
+        .ifEmpty { state.externalController }
+    val secret = storage.getString(StorageKeys.PANEL_LAST_SECRET, "")
+        .ifEmpty { state.secret }
+    return externalPanelUrl(ec, secret)
+}
+
+/** 由内核外部控制器的 host/port/secret 拼装 zashboard URL（?host&secret 由 SPA 自行读取，避免 #/setup 页）。 */
+fun externalPanelUrl(externalController: String, secret: String): String {
+    val ep = externalController.split('@').last().trimStart('/')
+    val host = if (ep.contains(':')) ep.substringBeforeLast(':') else ep
+    val port = if (ep.contains(':')) ep.substringAfterLast(':') else ""
+    val sb = StringBuilder("https://zashboard.pages.dev/?host=")
+    sb.append(Uri.encode(host))
+    if (port.isNotEmpty()) sb.append("&port=").append(Uri.encode(port))
+    if (secret.isNotEmpty()) sb.append("&secret=").append(Uri.encode(secret))
+    sb.append("#/proxies")
+    return sb.toString()
+}
+
+/** 诊断日志环：保留最近 60 条，「调节」抽屉里可复制。 */
+class PanelDiagLog {
+    private val lines = ArrayDeque<String>()
+
+    @Synchronized
+    fun add(line: String) {
+        lines.addLast(line)
+        if (lines.size > 60) lines.removeFirst()
+    }
+
+    var swLayerApplied = false
+
+    @Synchronized
+    fun text(): String = lines.joinToString("\n")
+}
+
+/**
+ * dvh 像素修复注入脚本（r8 五链路版本；r10 起仅作为坏引擎兜底）。
+ * 先检测 `1dvh` 是否解析为 0 且根节点非零高：好引擎 not-needed 零干预；坏引擎注入 px 规则。
+ */
+private const val DVH_FIX_JS = """
+(function(){
+  try{
+    var root=document.getElementById('app');
+    var ih=window.innerHeight||0;
+    var t=document.createElement('div');
+    t.style.cssText='position:fixed;left:-9999px;top:0;height:1dvh;pointer-events:none;';
+    document.body.appendChild(t);
+    var dvhPx=Math.round(t.getBoundingClientRect().height);
+    t.remove();
+    if(!root||root.clientHeight===0||ih===0){return 'skip h='+ih;}
+    if(dvhPx>0){
+      var old=document.getElementById('mishka-dvh-fix');
+      if(old){old.remove();}
+      return 'not-needed';
+    }
+    if(!ih||ih<=0){return 'skip h='+ih;}
+    if(!window.matchMedia||!window.matchMedia('(min-width:768px)').matches){return 'skip-narrow w='+(window.innerWidth||0);}
+    if(document.getElementById('mishka-dvh-fix')){return 'already h='+ih;}
+    var h=ih+'px';
+    var s=document.createElement('style');
+    s.id='mishka-dvh-fix';
+    s.textContent=
+      '#app{height:'+h+' !important;}'+
+      '.router{height:'+h+' !important;}'+
+      '.router>div{min-height:'+h+' !important;}'+
+      '.router-view{min-height:'+h+' !important;}'+
+      '.page-wrapper{height:'+h+' !important;min-height:'+h+' !important;}'+
+      '.proxy-page,.rule-page,.connection-page,.log-page,.dns-page,.provider-page,.resource-page,.setting-page{height:'+h+' !important;}'+
+      '@media(min-width:768px){'+
+        ':root{--vh:'+ih+'px;}'+
+        '.proxy-page{height:'+h+' !important;}'+
+        '.side-bar{height:calc(100dvh - 20px) !important;}'+
+        '.page-content{height:calc(100dvh - 100px) !important;}'+
+        '.main{max-height:calc(100dvh - 100px) !important;}'+
+        '.rule-set-provider-list,.dns-query-content,.log-list,.connections,.provider-list,.resources,.settings{max-height:calc(100dvh - 100px) !important;}'+
+      '}'+
+      '@media(min-width:768px) and (max-height:99999px){'+
+        '.side-bar{height:calc('+h+' - 20px) !important;}'+
+        '.page-content{height:calc('+h+' - 100px) !important;}'+
+        '.main{max-height:calc('+h+' - 100px) !important;}'+
+        '.rule-set-provider-list,.dns-query-content,.log-list,.connections,.provider-list,.resources,.settings{max-height:calc('+h+' - 100px) !important;}'+
+      '}';
+    document.head.appendChild(s);
+    var sel=['.proxy-page','.rule-page','.connection-page','.log-page','.dns-page','.provider-page','.resource-page','.setting-page'];
+    sel.forEach(function(q){
+      document.querySelectorAll(q).forEach(function(el){
+        el.style.setProperty('height',h,'important');
+        el.style.setProperty('min-height',h,'important');
+      });
+    });
+    window.addEventListener('resize',function(){
+      if(window.matchMedia&&window.matchMedia('(min-width:768px)').matches&&window.innerHeight>0){
+        var old=document.getElementById('mishka-dvh-fix');
+        if(old){old.remove();}
+        if(window.__mishkaFixDvh){window.__mishkaFixDvh();}
+      }
+    });
+    window.__mishkaDvhFixApplied=h;
+    return 'injected-px:'+ih;
+  }catch(e){return 'fixerr:'+e;}
+})()
+"""
+
+/** 布局探针：记录 #app 与关键节点的真实几何。 */
+private const val PROBE_JS = """
+(function(){
+  function info(el){if(!el)return null;var r=el.getBoundingClientRect();var cs=getComputedStyle(el);return{t:Math.round(r.top),h:Math.round(r.height),op:cs.opacity,vis:cs.visibility,cc:cs.contentVisibility,ov:cs.overflow};}
+  function op(q){var el=document.querySelector(q);if(!el)return null;return getComputedStyle(el).opacity;}
+  try{
+    var root=document.getElementById('app');
+    var sc=document.querySelector('.side-bar-content-scroller');
+    var nav=document.querySelector('.tab-bar');
+    var card=document.querySelector('.proxy-group-card');
+    return JSON.stringify({
+      w:window.innerWidth,h:window.innerHeight,
+      vhPx:Math.round((function(){var t=document.createElement('div');t.style.cssText='position:fixed;left:-9999px;height:1vh';document.body.appendChild(t);var v=Math.round(t.getBoundingClientRect().height);t.remove();return v;})()),
+      dvhPx:Math.round((function(){var t=document.createElement('div');t.style.cssText='position:fixed;left:-9999px;height:1dvh';document.body.appendChild(t);var v=Math.round(t.getBoundingClientRect().height);t.remove();return v;})()),
+      w1:(window.__mishkaDvhFixApplied||null),
+      root:info(root),
+      hp:(root?root.clientHeight:null),
+      rf:(root?Math.round(root.getBoundingClientRect().height):null),
+      scroller:info(sc),
+      nav:info(nav),
+      cards:(document.querySelectorAll('.proxy-group-card').length),
+      card0:info(card),
+      ccOp:op('.side-bar-content-scroller'),
+      cardOp:op('.proxy-group-card'),
+      navOp:op('.tab-bar'),
+      pageOp:op('.page-wrapper')
+    });
+  }catch(e){return 'probeerr:'+e;}
+})()
+"""
+
+private fun fixDvh(view: WebView?, diag: PanelDiagLog) {
+    if (view == null) return
+    view.evaluateJavascript(DVH_FIX_JS) { result ->
+        val r = result?.trim('"').orEmpty()
+        diag.add("[fix] $r")
+        // r10：传统 View 宿主正常绘制；软件层开关保留为坏引擎兜底（每会话至多一次）
+        if (r.startsWith("injected-px") && !diag.swLayerApplied) {
+            diag.swLayerApplied = true
+            view.post {
+                view.setLayerType(View.LAYER_TYPE_SOFTWARE, null)
+                diag.add("[paint] software layer applied (fallback for broken dvh engine)")
+            }
+        }
+    }
+}
+
+private fun nudgeResize(view: WebView?, diag: PanelDiagLog) {
+    view?.evaluateJavascript(
+        "window.dispatchEvent(new Event('resize'));window.scrollBy(0,1);window.scrollBy(0,-1);'nudged'"
+    ) { diag.add("[nudge] $it") }
+}
+
+private fun runProbe(view: WebView?, diag: PanelDiagLog, index: Int) {
+    view?.evaluateJavascript(PROBE_JS) { diag.add("[probe#$index] $it") }
+}
