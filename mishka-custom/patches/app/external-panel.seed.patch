diff --git a/app/src/main/res/layout/activity_external_panel.xml b/app/src/main/res/layout/activity_external_panel.xml
new file mode 100644
index 0000000..0d26ef3
--- /dev/null
+++ b/app/src/main/res/layout/activity_external_panel.xml
@@ -0,0 +1,75 @@
+<?xml version="1.0" encoding="utf-8"?>
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="?android:attr/colorBackground"
+    android:fitsSystemWindows="true"
+    android:orientation="vertical">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="56dp"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        android:paddingStart="4dp"
+        android:paddingEnd="4dp">
+
+        <ImageView
+            android:id="@+id/panel_back"
+            android:layout_width="48dp"
+            android:layout_height="48dp"
+            android:background="?android:attr/selectableItemBackgroundBorderless"
+            android:contentDescription="@string/external_panel_back"
+            android:padding="12dp"
+            android:src="@drawable/ic_panel_back"
+            android:tint="?android:attr/textColorPrimary" />
+
+        <TextView
+            android:id="@+id/panel_title"
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_weight="1"
+            android:ellipsize="end"
+            android:paddingStart="8dp"
+            android:paddingEnd="8dp"
+            android:singleLine="true"
+            android:textColor="?android:attr/textColorPrimary"
+            android:textSize="17sp" />
+
+        <ImageView
+            android:id="@+id/panel_refresh"
+            android:layout_width="48dp"
+            android:layout_height="48dp"
+            android:background="?android:attr/selectableItemBackgroundBorderless"
+            android:contentDescription="@string/external_panel_refresh"
+            android:padding="12dp"
+            android:src="@drawable/ic_panel_refresh"
+            android:tint="?android:attr/textColorPrimary" />
+
+        <ImageView
+            android:id="@+id/panel_tune"
+            android:layout_width="48dp"
+            android:layout_height="48dp"
+            android:background="?android:attr/selectableItemBackgroundBorderless"
+            android:contentDescription="@string/external_panel_tune"
+            android:padding="12dp"
+            android:src="@drawable/ic_panel_tune"
+            android:tint="?android:attr/textColorPrimary" />
+
+        <ImageView
+            android:id="@+id/panel_delete"
+            android:layout_width="48dp"
+            android:layout_height="48dp"
+            android:background="?android:attr/selectableItemBackgroundBorderless"
+            android:contentDescription="@string/external_panel_clear_cache"
+            android:padding="12dp"
+            android:src="@drawable/ic_panel_delete"
+            android:tint="?android:attr/textColorPrimary" />
+    </LinearLayout>
+
+    <WebView
+        android:id="@+id/panel_web"
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_weight="1" />
+</LinearLayout>
