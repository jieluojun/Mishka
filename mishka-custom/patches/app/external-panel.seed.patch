+                        .heightIn(max = 420.dp)
+                        .padding(top = 8.dp)
+                        .fillMaxWidth()
+                        .verticalScroll(rememberScrollState()),
+                ) {
+                    Text(
+                        text = diag.text(),
+                        fontSize = 11.sp,
+                        color = MiuixTheme.colorScheme.onSurfaceVariantSummary,
+                    )
+                }
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(top = 12.dp),
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    TextButton(
+                        text = stringResource(R.string.external_panel_diag_copy),
+                        modifier = Modifier.weight(1f),
+                        onClick = { clipboard.setText(AnnotatedString(diag.text())) },
+                    )
+                    TextButton(
+                        text = stringResource(R.string.external_panel_diag_open_browser),
+                        modifier = Modifier.weight(1f),
+                        onClick = {
+                            runCatching {
+                                context.startActivity(
+                                    Intent(Intent.ACTION_VIEW, Uri.parse(url)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+                                )
+                            }
+                        },
+                    )
+                    TextButton(
+                        text = stringResource(R.string.external_panel_diag_close),
+                        modifier = Modifier.weight(1f),
+                        onClick = { showDiag = false },
+                    )
+                }
+            }
+        }
+    }
+}
+
+/** 补发 resize/scroll：WebView 视口尺寸变化不一定触发 window 事件，虚拟列表可能停在 0 行。 */
+private fun nudgeResize(view: WebView?, diag: PanelDiagLog) {
+    runCatching {
+        view?.evaluateJavascript(
+            "window.dispatchEvent(new Event('resize'));window.dispatchEvent(new Event('scroll'));'nudged'",
+        ) { diag.add("[nudge] $it") }
+    }
+}
+
+/**
+ * v3（r8）：r7 回传证明像素高度只修好了根容器（root=776/bodyH=776），**中间链仍断**：
+ * scroller 0 高、nav 仍被 0 高定位祖先顶出（`vhPx:0 dvhPx:0` 坐实全部视口单位为 0，
+ * 而 %/flex 的高度传递在该 WebView 上也不可靠）。v3 不再赌级联语义：给
+ * 根容器→wrapper→`.home-page`→`.relative.flex-1`→滚动容器 **每一环显式像素高度**
+ * （样式表 + 内联 `!important` 双保险），resize 重算；dvh 档位映射保留（弹窗等）。
+ * 生效条件不变：`.h-dvh` 实测 0 高且 innerHeight>0（好引擎 `not-needed` 零干预）。
+ */
+private val DVH_FIX_JS: String = """
+(function(){
+  var ih=window.innerHeight; if(!(ih>0)) return 'no-vp';
+  var r=document.querySelector('.h-dvh'); if(!r) return 'no-root';
+  if(r.getBoundingClientRect().height!==0 && !document.getElementById('mishka-dvh-fix')) return 'not-needed';
+  var P=ih+'px';
+  function css(h){var q=h+'px';return '.h-dvh{height:'+q+'!important}'
+    +'.h-dvh>.flex.w-screen{height:'+q+'!important}'
+    +'.home-page{height:'+q+'!important}'
+    +'.home-page>.relative.flex-1{height:'+q+'!important}'
+    +'.h-dvh .flex-col.h-full.overflow-y-auto{height:'+q+'!important}'
+    +'.h-\\[70dvh\\]{height:'+Math.round(h*0.7)+'px!important}'
+    +'.h-\\[calc\\(100dvh-3rem\\)\\]{height:'+Math.max(h-48,0)+'px!important}'
+    +'.max-h-\\[50dvh\\]{max-height:'+Math.round(h*0.5)+'px!important}'
+    +'.max-h-\\[65dvh\\]{max-height:'+Math.round(h*0.65)+'px!important}'
+    +'.max-h-\\[70dvh\\]{max-height:'+Math.round(h*0.7)+'px!important}'
+    +'.max-md\\:max-h-\\[50dvh\\]{max-height:'+Math.round(h*0.5)+'px!important}'
+    +'.max-md\\:max-h-\\[85dvh\\]{max-height:'+Math.round(h*0.85)+'px!important}'
+    +'.max-md\\:min-h-\\[40dvh\\]{min-height:'+Math.round(h*0.4)+'px!important}'
+    +'.md\\:max-h-\\[90dvh\\]{max-height:'+Math.round(h*0.9)+'px!important}'
+    +'.custom-background .table-glass:before{height:'+q+'!important;margin-bottom:-'+q+'!important}'
+    +' *{transition-duration:0s!important;transition-delay:0s!important;animation-duration:0s!important;animation-delay:0s!important}'
+    +'.proxy-group-card-content,.proxy-group-card,.tab-bar,.tab-bar-item,.tab-bar-label,.tab-bar-icon,.page-enter-from,.page-enter-active,.page-leave-to{opacity:1!important;visibility:visible!important}';}
+  var SEL=['.h-dvh','.h-dvh>.flex.w-screen','.home-page','.home-page>.relative.flex-1','.h-dvh .flex-col.h-full.overflow-y-auto'];
+  function apply(h){
+    var s=document.getElementById('mishka-dvh-fix');
+    if(!s){s=document.createElement('style');s.id='mishka-dvh-fix';(document.head||document.documentElement).appendChild(s);}
+    s.textContent=css(h);
+    for(var i=0;i<SEL.length;i++){var e=document.querySelector(SEL[i]);if(e)e.style.setProperty('height',h+'px','important');}
+  }
+  apply(ih);
+  if(!document.body.hasAttribute('data-dvhfix-listener')){
+    document.body.setAttribute('data-dvhfix-listener','1');
+    window.addEventListener('resize',function(){var h=window.innerHeight;if(h>0)apply(h);});
+  }
+  return 'injected-px:'+ih;
+})()
+""".trimIndent()
+
+private fun fixDvh(view: WebView?, diag: PanelDiagLog) {
+    runCatching {
+        view?.evaluateJavascript(DVH_FIX_JS) { res ->
+            diag.add("[dvhfix] $res")
+            // r9：设备实证「几何全对但普通文档层不绘制」（fixed 顶栏属独立合成层、唯独它渲染）——
+            // 该类 GPU 光栅/合成缺陷的标准缓解是换渲染管线。确认坏视口引擎且几何修复生效后，
+            // 把 WebView 切到软件渲染层强制全量重绘（每会话一次，[paint] 行回传）。
+            if (res.contains("injected-px") && !diag.swLayerApplied) {
+                diag.swLayerApplied = true
+                view.post {
+                    view.setLayerType(View.LAYER_TYPE_SOFTWARE, null)
+                    diag.add("[paint] LAYER_TYPE_SOFTWARE (broken-viewport engine)")
+                }
+            }
+        }
+    }
+}
+
+/** 在面板页面里量取关键布局量：区分"高度链塌陷 / 虚拟列表零行 / 纯绘制问题"。 */
+private fun runProbe(view: WebView, diag: PanelDiagLog, round: Int) {
+    runCatching {
+        view.evaluateJavascript(PROBE_JS) { result ->
+            diag.add("[probe#$round] $result")
+        }
+    }
+}
+
+/**
+ * 探针只读不写：根容器（`.h-dvh`）高度、页面滚动容器高度、虚拟列表行（`.proxy-group-card`）
+ * 数量与首行 top、底栏（`.tab-bar`）几何、dvh 支持度、localStorage 可用性、UA/引擎版本。
+ */
+private val PROBE_JS = """
+(function(){
+  function r(s){return document.querySelector(s)}
+  function rect(e){if(!e)return null;var b=e.getBoundingClientRect();return {t:Math.round(b.top),h:Math.round(b.height),w:Math.round(b.width)}}
+  var root=r('.h-dvh');
+  var scroller=r('.h-dvh .overflow-y-auto');
+  var cards=document.querySelectorAll('.proxy-group-card');
+  var nav=r('.tab-bar');
+  var ls=(function(){try{localStorage.setItem('__mishka_t','1');localStorage.removeItem('__mishka_t');return 'ok'}catch(e){return 'ERR:'+e.name}})();
+  var m=(navigator.userAgent.match(/Chrome\/([0-9.]+)/)||[])[1]||'?';
+  var t=document.createElement('div');t.style.cssText='position:absolute;visibility:hidden;height:100vh';
+  document.body.appendChild(t);var vhPx=t.offsetHeight;t.style.height='100dvh';var dvhPx=t.offsetHeight;t.remove();
+  function op(e){return e?getComputedStyle(e).opacity:null}
+  var fs=r('#mishka-dvh-fix');
+  var w1=r('.h-dvh>.flex.w-screen'), hp=r('.home-page'), rf=r('.home-page>.relative.flex-1');
+  return JSON.stringify({
+    chrome:m, ls:ls, iw:innerWidth, ih:innerHeight, vhPx:vhPx, dvhPx:dvhPx,
+    root:rect(root), rootCssH:root?getComputedStyle(root).height:null, inlineH:root?root.style.height:null,
+    w1:rect(w1), hp:rect(hp), rf:rect(rf),
+    fixLen:fs?fs.textContent.length:0,
+    scroller:rect(scroller), scrollerCssH:scroller?getComputedStyle(scroller).height:null,
+    cards:cards.length, card0:rect(cards[0]), card0Top:cards[0]?cards[0].style.top:null,
+    nav:rect(nav), navPos:nav?getComputedStyle(nav).position:null, navBottom:nav?getComputedStyle(nav).bottom:null,
+    ccOp:op(r('.proxy-group-card-content')), cardOp:op(r('.proxy-group-card')), navOp:op(r('.tab-bar')),
+    pageOp:op(r('.page-enter-from,.page-enter-active')),
+    dvh:CSS.supports('height','100dvh'), oklch:CSS.supports('color','oklch(0.5 0.1 100)'),
+    has:CSS.supports('selector(:has(*))'), bodyH:document.body.clientHeight
+  })
+})()
+""".trimIndent()
+
+/** 诊断环形缓冲：最多保留 [CAP] 行，跨线程安全（WebView 回调在 IO/主线程都可能到来）。 */
+class PanelDiagLog {
+    private val buf = ArrayDeque<String>(CAP)
+    private val lock = Any()
+    /** 本会话是否已切软件渲染层（只切一次）。 */
+    var swLayerApplied = false
+
+    fun add(line: String) {
+        synchronized(lock) {
+            if (buf.size >= CAP) buf.removeFirst()
+            buf.addLast(line)
+        }
+    }
+
+    fun text(): String = synchronized(lock) { buf.joinToString("\n") }
+
+    private companion object {
+        const val CAP = 240
+    }
+}
+
+/**
+ * 运行中的 external-controller → 面板地址。`0.0.0.0` / `*` / `::` 是监听通配地址、不可连接，
+ * 换成本机回环；缺省端口按 mihomo 惯例不补（配置里 host:port 一体）。
+ *
+ * 两个必须遵守的实测约束：
+ * - **尾部斜杠**：内核对 `/ui`（无斜杠）回 307 重定向，`Location: /ui/` 会丢掉全部
+ *   query 参数，面板拿不到 host/secret 就会停在手动设置页。
+ * - **自动登录参数**：zashboard 的 URL 契约是 `?hostname=&port=&secret=`（gate 参数是
+ *   `hostname`，缺失时返回 null → 手动设置页；没有 `host`/`token` 兼容分支）。
+ */
+fun externalPanelUrl(externalController: String, secret: String = ""): String {
+    val raw = externalController.trim()
+        .removePrefix("http://")
+        .removePrefix("https://")
+        .substringBefore('/')
+    val host = raw.substringBeforeLast(':').ifEmpty { "127.0.0.1" }
+    val port = raw.substringAfterLast(':', "")
+    val reachableHost = if (host == "0.0.0.0" || host == "*" || host == "::" || host == "[::]") {
+        "127.0.0.1"
+    } else {
+        host
+    }
+    val base = if (port.isEmpty()) "http://$reachableHost/ui/" else "http://$reachableHost:$port/ui/"
+    val params = buildString {
+        append("?hostname=").append(Uri.encode(reachableHost))
+        if (port.isNotEmpty()) append("&port=").append(Uri.encode(port))
+        if (secret.isNotEmpty()) append("&secret=").append(Uri.encode(secret))
+    }
+    return base + params
+}
