+package top.yukonga.mishka.custom.panel
+
+import android.util.Log
+import android.webkit.CookieManager
+import android.webkit.WebResourceRequest
+import android.webkit.WebResourceResponse
+import kotlinx.coroutines.runBlocking
+import org.koin.core.context.GlobalContext
+import top.yukonga.mishka.data.repository.SubscriptionProxyResolver
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.InetSocketAddress
+import java.net.Proxy
+import java.net.URI
+import java.net.URL
+
+/**
+ * 外部面板（WebView）的外网请求改走 mihomo mixed-port。
+ *
+ * 问题：Mishka 自身 UID 在 TPROXY 下被 `out-bypass-self` 直连放行，VPN 下 `addDisallowedApplication`
+ * 把自己排除在外，所以应用内 WebView 的外网请求全部直连——国外站点解析成国内 IP、YouTube 等被墙站点测不出延迟。
+ * 浏览器是另一个 UID，走代理正常。
+ *
+ * 做法：`WebViewClient.shouldInterceptRequest` 里，对「非本机」的 GET/HEAD 请求改由
+ * `HttpURLConnection(Proxy HTTP 127.0.0.1:mixed-port)` 拉取，再把响应原样交还 WebView。
+ * 与 [SubscriptionProxyResolver] 的既有用法一致（订阅更新 / 规则延迟 / 图标下载都走同一个本机端口）。
+ *
+ * 不拦截（返回 null，WebView 照常直连）的情况：
+ *  - 本机地址（127.0.0.1 / localhost / ::1 / 0.0.0.0）：外部面板自身与 external-controller 都在这里；
+ *  - 非 GET/HEAD（WebResourceRequest 拿不到请求体，POST 无法安全转发）；
+ *  - 代理未运行或拿不到 mixed-port；
+ *  - 代理请求出错（回退直连，行为与修复前一致）。
+ *
+ * Cookie：请求侧补 CookieManager 里的 Cookie；响应侧 Set-Cookie 写回 CookieManager，登录态不丢。
+ */
+internal object PanelProxyFetcher {
+
+    private const val TAG = "PanelProxyFetcher"
+
+    /** 代理地址缓存时长：避免每个子资源都去查一次 mihomo API。 */
+    private const val PROXY_TTL_MS = 5_000L
+
+    private const val CONNECT_TIMEOUT_MS = 15_000
+    private const val READ_TIMEOUT_MS = 30_000
+
+    private val LOCAL_HOSTS = setOf("127.0.0.1", "localhost", "::1", "[::1]", "0.0.0.0")
+
+    /** 转发请求时不回传的头：Host / Connection 由 HttpURLConnection 自己管理。 */
+    private val SKIP_REQUEST_HEADERS = setOf("host", "connection", "content-length", "keep-alive")
+
+    /** 响应里不回传的头：HttpURLConnection 已解分块，保留会让 WebView 误解析。 */
+    private val SKIP_RESPONSE_HEADERS = setOf("transfer-encoding", "connection", "keep-alive", "set-cookie")
+
+    @Volatile
+    private var cachedProxyUrl: String? = null
+
+    @Volatile
+    private var cachedAt: Long = 0L
+
+    @Volatile
+    private var cachedValid = false
+
+    private val resolver: SubscriptionProxyResolver by lazy {
+        GlobalContext.get().get<SubscriptionProxyResolver>()
+    }
+
+    /** WebView 的 shouldInterceptRequest 调用入口（后台线程）。返回 null 表示由 WebView 直连。 */
+    fun intercept(request: WebResourceRequest): WebResourceResponse? {
+        val uri = request.url ?: return null
+        val scheme = uri.scheme.orEmpty()
+        if (scheme != "http" && scheme != "https") return null
+        val host = uri.host.orEmpty().lowercase()
+        if (host.isEmpty() || host in LOCAL_HOSTS) return null
+        val method = request.method.orEmpty().uppercase()
+        if (method != "GET" && method != "HEAD") return null
+
+        val proxy = currentProxy() ?: return null
+        return runCatching { fetch(request, uri.toString(), method, proxy) }
+            .onFailure { Log.w(TAG, "proxy fetch failed, fallback direct: ${it.message}") }
+            .getOrNull()
+    }
+
+    private fun currentProxy(): Proxy? {
+        val now = System.currentTimeMillis()
+        val url = if (cachedValid && now - cachedAt < PROXY_TTL_MS) {
+            cachedProxyUrl
+        } else {
+            val resolved = runCatching { runBlocking { resolver.resolve(requireUserToggle = false) } }
+                .getOrNull()
+            cachedProxyUrl = resolved
+            cachedAt = now
+            cachedValid = true
+            resolved
+        } ?: return null
+        val port = runCatching { URI(url).port }.getOrDefault(-1)
+        if (port <= 0) return null
+        return Proxy(Proxy.Type.HTTP, InetSocketAddress("127.0.0.1", port))
+    }
+
+    private fun fetch(
+        request: WebResourceRequest,
+        url: String,
+        method: String,
+        proxy: Proxy,
+    ): WebResourceResponse? {
+        val cookieManager = CookieManager.getInstance()
+        val conn = (URL(url).openConnection(proxy) as HttpURLConnection).apply {
+            requestMethod = method
+            connectTimeout = CONNECT_TIMEOUT_MS
+            readTimeout = READ_TIMEOUT_MS
+            instanceFollowRedirects = true
+            request.requestHeaders?.forEach { (name, value) ->
+                if (name.lowercase() !in SKIP_REQUEST_HEADERS) setRequestProperty(name, value)
+            }
+            if (getRequestProperty("Cookie").isNullOrBlank()) {
+                cookieManager.getCookie(url)?.takeIf { it.isNotBlank() }?.let { setRequestProperty("Cookie", it) }
+            }
+        }
+
+        val code = conn.responseCode
+        if (code <= 0) {
+            conn.disconnect()
+            return null
+        }
+        val stream = try {
+            conn.inputStream
+        } catch (_: IOException) {
+            conn.errorStream ?: run {
+                conn.disconnect()
+                return null
+            }
+        }
+
+        val headers = LinkedHashMap<String, String>()
+        conn.headerFields?.forEach { (name, values) ->
+            if (name == null || values.isNullOrEmpty()) return@forEach
+            val lower = name.lowercase()
+            if (lower == "set-cookie") {
+                values.forEach { cookieManager.setCookie(url, it) }
+            } else if (lower !in SKIP_RESPONSE_HEADERS) {
+                headers[name] = values.joinToString(", ")
+            }
+        }
+
+        val contentType = conn.contentType.orEmpty()
+        val mime = contentType.substringBefore(';').trim().ifBlank { "application/octet-stream" }
+        val charset = Regex("charset=\"?([^\";\\s]+)", RegexOption.IGNORE_CASE)
+            .find(contentType)?.groupValues?.get(1)
+
+        return WebResourceResponse(
+            mime,
+            charset,
+            code,
+            conn.responseMessage.orEmpty().ifBlank { "OK" },
+            headers,
+            stream,
+        )
+    }
+}
