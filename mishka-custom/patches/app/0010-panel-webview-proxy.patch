+++ b/app/src/main/kotlin/top/yukonga/mishka/custom/panel/PanelProxyOverride.kt
@@ -0,0 +1,110 @@
+package top.yukonga.mishka.custom.panel
+
+import android.content.Context
+import android.util.Log
+import androidx.core.content.ContextCompat
+import androidx.webkit.ProxyConfig
+import androidx.webkit.ProxyController
+import androidx.webkit.WebViewFeature
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.CancellableContinuation
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+import org.koin.core.context.GlobalContext
+import top.yukonga.mishka.data.repository.SubscriptionProxyResolver
+import top.yukonga.mishka.platform.ProxyServiceBridge
+import java.net.URI
+import java.util.concurrent.Executor
+import kotlin.coroutines.resume
+
+/**
+ * 外部面板（WebView）的代理覆盖：让面板里的外网请求经 mihomo mixed-port 出站。
+ *
+ * 背景：Mishka 自身 UID 被代理规则排除（TPROXY 的 out-bypass-self / VPN 的 addDisallowedApplication），
+ * 应用内 WebView 的请求一直直连——国外站点测出国内出口、YouTube 测不出延迟。浏览器是另一个 UID，走代理正常。
+ *
+ * 做法：`androidx.webkit.ProxyController.setProxyOverride` 给进程内所有 WebView 设一条代理规则
+ * `127.0.0.1:<mixed-port>`，本机地址（localhost / 127.* / [::1] / external-controller 主机）不走代理。
+ * 这是唯一能覆盖 GET 之外（POST / PUT 等）请求的途径：平台 `shouldInterceptRequest` 拿不到请求体。
+ *
+ * 行为：
+ *  - 代理未运行、拿不到 mixed-port、或 WebView provider 不支持 PROXY_OVERRIDE → 清除覆盖 / 不设置，页面直连（与修复前一致）；
+ *  - 端口变化时在下次进入面板时重设（[appliedRule] 对比）；
+ *  - 设置是异步的：[ensure] 等待 listener 回调（超时 [APPLY_TIMEOUT_MS] 后放行，不阻塞页面）；
+ *    调用方要在 ensure 返回后再创建 / 加载 WebView，否则首屏请求可能抢在代理设置之前发出。
+ */
+internal object PanelProxyOverride {
+
+    private const val TAG = "PanelProxyOverride"
+
+    /** 等待 setProxyOverride 回调的上限：超时仍放行页面（直连兜底），不让面板卡死。 */
+    private const val APPLY_TIMEOUT_MS = 3_000L
+
+    private val mutex = Mutex()
+
+    /** 当前已生效的代理规则（"127.0.0.1:port"）；空串表示已清除 / 未设置。 */
+    @Volatile
+    private var appliedRule: String? = null
+
+    private val resolver: SubscriptionProxyResolver by lazy {
+        GlobalContext.get().get<SubscriptionProxyResolver>()
+    }
+
+    /**
+     * 确保面板 WebView 的代理覆盖与当前 mihomo 状态一致。返回 true 表示可以开始加载页面
+     * （无论是否设置成功，失败都按直连处理）。
+     */
+    suspend fun ensure(context: Context): Boolean = mutex.withLock {
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.PROXY_OVERRIDE)) {
+            Log.i(TAG, "WebView provider 不支持 PROXY_OVERRIDE，面板直连")
+            return@withLock true
+        }
+        val proxyUrl = withContext(Dispatchers.IO) {
+            runCatching { resolver.resolve(requireUserToggle = false) }.getOrNull()
+        }
+        val port = proxyUrl?.let { runCatching { URI(it).port }.getOrDefault(-1) } ?: -1
+        val rule = if (port in 1..65535) "127.0.0.1:$port" else ""
+        if (rule == appliedRule) return@withLock true
+
+        val executor = ContextCompat.getMainExecutor(context)
+        val ok = if (rule.isEmpty()) clearOverride(executor) else setOverride(executor, rule)
+        if (ok) appliedRule = rule
+        Log.i(TAG, "面板代理覆盖 rule='$rule' ok=$ok")
+        true
+    }
+
+    private suspend fun setOverride(executor: Executor, rule: String): Boolean {
+        val controllerHost = ProxyServiceBridge.state.value.externalController
+            .substringBeforeLast(':')
+            .takeIf { it.isNotBlank() && it != "0.0.0.0" }
+        return awaitListener { done ->
+            val builder = ProxyConfig.Builder()
+                .addProxyRule(rule)
+                .addBypassRule("localhost")
+                .addBypassRule("127.*")
+                .addBypassRule("[::1]")
+            controllerHost?.let { builder.addBypassRule(it) }
+            ProxyController.getInstance().setProxyOverride(builder.build(), executor, done)
+        }
+    }
+
+    private suspend fun clearOverride(executor: Executor): Boolean =
+        awaitListener { done ->
+            ProxyController.getInstance().clearProxyOverride(executor, done)
+        }
+
+    /** 把 listener 风格的 API 包成挂起函数；超时或调用抛异常都返回 false。 */
+    private suspend fun awaitListener(call: (Runnable) -> Unit): Boolean = withTimeoutOrNull(APPLY_TIMEOUT_MS) {
+        suspendCancellableCoroutine<Boolean> { cont: CancellableContinuation<Boolean> ->
+            runCatching {
+                call(Runnable { if (cont.isActive) cont.resume(true) })
+            }.onFailure {
+                Log.w(TAG, "setProxyOverride 调用失败：${it.message}")
+                if (cont.isActive) cont.resume(false)
+            }
+        }
+    } ?: false
+}
