index 0000000..aaaafa5
--- /dev/null
+++ b/app/src/main/kotlin/top/yukonga/mishka/service/ExtCtlPortGuard.kt
@@ -0,0 +1,65 @@
+package top.yukonga.mishka.service
+
+import android.util.Log
+import java.net.InetSocketAddress
+import java.net.Socket
+
+/**
+ * r10 二轮：external-controller 端口冲突自愈。
+ *
+ * 设备实证（2026-10-04 回传）：`External controller listen error: listen tcp 127.0.0.1:9090:
+ * bind: address already in use` 形态的启动失败——[RootHelper.cleanupOrphanedMihomo] 只清
+ * Mishka 自己的 `libmihomo_runner.so` 孤儿，**第三方 clash 系应用的内核**（对照测试装的
+ * BoxProxy 等，默认同样监听 127.0.0.1:9090）占了首选端口时，mihomo 的 external-controller
+ * bind 失败 → 进程活着但 API 无响应 → 主页「已停止」+ 面板连不上只能停在 setup 页。
+ *
+ * 自愈规则（只在本机回环地址上生效，远程 controller 原样保留）：
+ * 1. 首选地址空闲 → 原样使用（尊重用户配置）；
+ * 2. 被占 → 从备用端口段 39090–39099 选第一个空闲者；
+ * 3. 备用段全占（极端）→ 仍用首选，让原有错误路径报错，不静默乱跳。
+ * 调用点在各启动路径装配 `--ext-ctl` 处（孤儿清理之后），bridge state / API 客户端 /
+ * 面板 URL 全部读 bridge 的 externalController，随 fallback 自动一致。
+ */
+object ExtCtlPortGuard {
+    private const val TAG = "ExtCtlPortGuard"
+    private val FALLBACK_PORTS = 39090..39099
+
+    private fun isLoopback(host: String): Boolean =
+        host == "127.0.0.1" || host == "localhost" || host == "::1" || host == "[::1]"
+
+    /** 能建立 TCP 连接即视为被监听（connect 被拒 = 空闲）。 */
+    fun isBusy(host: String, port: Int): Boolean = try {
+        Socket().use { s ->
+            s.connect(InetSocketAddress(host, port), 250)
+            true
+        }
+    } catch (_: Exception) {
+        false
+    }
+
+    fun resolve(preferred: String): String {
+        val host = preferred.substringBeforeLast(':')
+        val port = preferred.substringAfterLast(':').toIntOrNull() ?: return preferred
+        if (!isLoopback(host)) {
+            StartDiag.add("[guard] preferred=$preferred remote host, keep")
+            return preferred
+        }
+        val busy = isBusy(host, port)
+        if (!busy) {
+            StartDiag.add("[guard] preferred=$preferred free, keep")
+            return preferred
+        }
+        val alt = firstFreeFallback(host)
+        if (alt == null) {
+            StartDiag.add("[guard] preferred=$preferred BUSY, no fallback free, keep preferred")
+            Log.w(TAG, "ext-ctl $preferred busy and no fallback port free; keeping preferred")
+            return preferred
+        }
+        StartDiag.add("[guard] preferred=$preferred BUSY, fallback $host:$alt")
+        Log.w(TAG, "ext-ctl $preferred occupied by foreign listener; falling back to $host:$alt")
+        return "$host:$alt"
+    }
+
+    /** r12：listen 失败重试时用——跳过首选，直接取备用段第一个空闲端口。 */
+    fun firstFreeFallback(host: String): Int? = FALLBACK_PORTS.firstOrNull { !isBusy(host, it) }
+}
