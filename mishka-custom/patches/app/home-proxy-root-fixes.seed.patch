@@ -0,0 +1,22 @@
+package top.yukonga.mishka.service
+
+/**
+ * r12：启动链路诊断环（进程级单例）。
+ *
+ * 动机：启动失败的 toast 只截取了内核日志一行（`External controller listen error: lis…`），
+ * 决定性的完整错误文本（bind 哪个地址、被谁占、cleanup 结果、attach 结果、重试结果）
+ * 在设备上不可见。本环保留最近 80 行，外部面板顶栏「调节」抽屉里与面板诊断一起展示、
+ * 可一键复制回传，下一轮定位不再靠猜。
+ */
+object StartDiag {
+    private val lines = ArrayDeque<String>()
+
+    @Synchronized
+    fun add(line: String) {
+        lines.addLast(line)
+        if (lines.size > 80) lines.removeFirst()
+    }
+
+    @Synchronized
+    fun text(): String = lines.joinToString("\n")
+}
