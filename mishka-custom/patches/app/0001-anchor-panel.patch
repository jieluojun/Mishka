+        rowSummary = { i, node ->
+            if (node.kind != YamlNode.Kind.MAP) "（别名 / 非映射项，只能在编辑器里改）"
+            else {
+                val type = FormValues.scalarText(doc, doc.findEntry(node, "type")?.node) ?: effectiveText(doc, GROUPS_PATH + i + "type").orEmpty()
