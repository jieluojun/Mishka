+private val CreateTemplate = DefBlock(
+    name = "",
+    keyDisplay = "",
+    keyRaw = "",
+    indent = 0,
+    dash = false,
+    kind = DefKind.Map,
+    headerValue = "",
+    headerComment = "",
+    entries = emptyList(),
