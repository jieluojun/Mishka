+        itemsIndexed(entries) { _, e ->
+            RowCard(
+                title = e.key,
+                summary = rowSummary(e.key, e.node),
+                onClick = { onOpen(e.key) },
+                endActions = {
+                    TextButton(text = "⋯", minWidth = 0.dp, minHeight = 0.dp, onClick = { menu = e.key })
+                },
+            )
+        }
+    }
+
