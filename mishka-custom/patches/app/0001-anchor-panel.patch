+                    RowCard(
+                        title = "内联节点 payload",
+                        summary = "${FormValues.count(doc, base + "payload")} 个节点 · 和「出站代理」同一套节点编辑器",
+                        onClick = { nav.push(FormRoute.Proxies(base + "payload", "$name · payload")) },
