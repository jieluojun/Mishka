+/** 映射（proxy-providers / rule-providers / sub-rules）的列表页：按名字一卡，「⋯」菜单里改名 / 删除。 */
+@Composable
+private fun MapListPage(
+    host: FormHost,
+    mapPath: YPath,
+    unit: String,
+    emptyHint: String,
+    headerActions: @Composable () -> Unit,
+    rowSummary: (String, YamlNode?) -> String?,
+    onOpen: (String) -> Unit,
