+/**
+ * 清除面板 WebView 的全部站点数据：缓存 / Cookie / Storage / 表单 / SSL 偏好。
+ *
+ * 必须在主线程跑：`WebView(context)` 构造会触碰 Chromium 的 UI 侧初始化，
+ * 换到 IO 线程去调只会拿到一屏 `WebView` 未附加的 logcat 噪声、清不掉东西。
+ */
+suspend fun clearWebViewAppData(context: Context): Boolean = withContext(Dispatchers.Main.immediate) {
+    runCatching {
+        val cookieManager = CookieManager.getInstance()
+        cookieManager.removeAllCookies(null)
+        cookieManager.flush()
+        runCatching { WebStorage.getInstance().deleteAllData() }
+        WebView(context).apply {
+            clearCache(true)
+            clearHistory()
+            clearFormData()
+            clearSslPreferences()
+            destroy()
+        }
+    }.isSuccess
+}
+
+/**
+ * 劫持 `<a download>` 的点击：面板里的「导出配置」是先 `URL.createObjectURL` 造 blob
+ * 再点一下隐藏链接，而 WebView 的 DownloadListener **收不到 blob:/data: 开头的地址**
+ * （没有 http 请求可拦）。所以这两类地址改成 fetch → base64 → JS bridge 走 SAF 存盘。
+ */
+private const val DOWNLOAD_HOOK_JS = """
+(function () {
+  if (window.__mishkaDownloadHookInstalled) return;
+  window.__mishkaDownloadHookInstalled = true;
+  function toBase64(blob) {
+    return new Promise(function (resolve, reject) {
+      var reader = new FileReader();
+      reader.onloadend = function () {
+        var result = reader.result || '';
+        var idx = result.indexOf(',');
+        resolve(idx >= 0 ? result.substring(idx + 1) : '');
+      };
+      reader.onerror = reject;
+      reader.readAsDataURL(blob);
+    });
+  }
+  var originalClick = HTMLAnchorElement.prototype.click;
+  HTMLAnchorElement.prototype.click = function () {
+    var anchor = this;
+    if (anchor.download) {
+      var href = anchor.getAttribute('href') || anchor.href || '';
+      if (href.indexOf('blob:') === 0 || href.indexOf('data:') === 0) {
+        fetch(href)
+          .then(function (r) { return r.blob(); })
+          .then(function (blob) {
+            return toBase64(blob).then(function (b64) {
+              window.MishkaAndroid.saveBase64File(
+                anchor.download || 'export',
+                blob.type || 'application/octet-stream',
+                b64
+              );
+            });
+          })
+          .catch(function () {});
+        return;
+      }
+    }
+    return originalClick.apply(this, arguments);
+  };
+})();
+"""
+
+private data class WebViewTag(
+    val reloadKey: Int,
+    val url: String,
+    val backRequestKey: Int,
+)
+
+/**
+ * 两阶段 WebView 预热器（box.app 同款）：
+ *
+ * 阶段 1（后台线程，立即）：`CookieManager.getInstance()` 触发 Chromium native library 加载；
+ * 阶段 2（主线程，空闲时）：预创建 WebView 实例并暂存，不加载任何 URL、零历史。
+ *
+ * 面板每次**进入**都是新 WebView + `loadUrl(入口)`（box.app 的返回进入逻辑），
+ * `new WebView()` 的 ~500ms 冷启是这套逻辑唯一的开销，预热后取用近乎 0ms。
+ * 用 WeakReference 暂存，避免静态持有 WebView 造成泄漏。
+ */
+internal object WebViewPreloader {
+    @Volatile
+    private var prewarmedRef: java.lang.ref.WeakReference<WebView>? = null
+
+    @Volatile
+    private var providerLoaded = false
+
+    /** 在 Activity.onCreate 调：先后台加载 Chromium provider，再在主线程空闲时预创建实例。 */
+    fun preload(context: Context) {
+        if (providerLoaded) return
+        providerLoaded = true
+        Thread {
+            runCatching { CookieManager.getInstance() }
+            Handler(Looper.getMainLooper()).post {
+                Looper.myQueue().addIdleHandler {
+                    if (prewarmedRef?.get() == null) {
+                        runCatching {
+                            val wv = WebView(context.applicationContext).apply {
+                                settings.javaScriptEnabled = true
+                                settings.domStorageEnabled = true
+                            }
+                            prewarmedRef = java.lang.ref.WeakReference(wv)
+                        }
+                    }
+                    false
+                }
+            }
+        }.start()
+    }
+
+    /** 取出预热的 WebView（一次性）；未就绪或已被 GC 回收则返回 null，调用方 fallback 到新建。 */
+    fun take(): WebView? {
+        val wv = prewarmedRef?.get()
+        prewarmedRef = null
+        return wv
+    }
+}
+
+/** Compose 视图的 context 可能是 ContextWrapper 链，逐层解包找宿主 Activity。 */
+private tailrec fun Context.findActivityOrNull(): Activity? = when (this) {
+    is Activity -> this
+    is ContextWrapper -> baseContext.findActivityOrNull()
+    else -> null
+}
+
+/**
+ * 跨「返回 / 重进」保留面板 WebView 实例。
+ *
+ * 返回退出面板页时 [androidx.compose.ui.viewinterop.AndroidView] 被拆掉，但 WebView 本身
+ * 不销毁、不丢弃：重进把**同一个实例**挂回视图树。没有这一层，每次重进都整页重载——
+ * 白闪（闪烁）+ 面板 SPA 重新初始化拉数据（卡片逐个冒出来，看着像缺卡），这两个症状
+ * 正是「重新加载」本身，box.app 的「每次进入新建 + loadUrl」也躲不掉。
+ *
+ * 语义仍按 box.app 的返回进入逻辑：重进用 [goHome] 回面板首页（历史回退，不重载）。
+ * 销毁点只有两个：
+ *  - [sessionKey] 变化（切面板）→ 销毁重建，避免带上一个面板的 history / JS 全局 / 登录态；
+ *  - Activity 销毁（recreate / finish）→ 销毁，WebView 持有 Activity 的 Context，留着就是泄漏。
+ *
+ * **宿主判活必须用 acquire 时记下的 Activity 身份**（[cachedHost]），不能拿
+ * `webView.context` 反查：预热器按 box.app 的做法给的是 application context，反查永远
+ * 是 null，会被误判「宿主已死」而销毁重建——现象就是「杀后台重进后第一次进正常、
+ * 返回再进就闪烁」（重建 + 整页 loadUrl）。
+ */
+internal object PanelWebViewCache {
+    private var cached: WebView? = null
+    private var cachedSessionKey = Int.MIN_VALUE
+    private var cachedHost: java.lang.ref.WeakReference<Activity>? = null
+    private var watcherInstalled = false
+
+    /**
+     * 取复用实例；返回 `webView` 与「是否新建」。新建的调用方要 `loadUrl(入口)`；
+     * 复用的**绝不能**再整页 load（那正是闪烁/缺卡的来源），重进回首页交给 [goHome]。
+     */
+    fun acquire(context: Context, sessionKey: Int): Pair<WebView, Boolean> {
+        installWatcher(context)
+        val host = context.findActivityOrNull()
+        val existing = cached
+        if (existing != null && host != null && cachedHost?.get() === host && cachedSessionKey == sessionKey) {
+            (existing.parent as? ViewGroup)?.removeView(existing)
+            return existing to false
+        }
+        destroy()
+        return (WebViewPreloader.take() ?: WebView(context)).also {
+            cached = it
+            cachedSessionKey = sessionKey
+            cachedHost = host?.let { h -> java.lang.ref.WeakReference(h) }
+        } to true
+    }
+
+    /** 销毁缓存实例（幂等）。 */
+    fun destroy() {
+        cached?.let { webView ->
+            (webView.parent as? ViewGroup)?.removeView(webView)
+            runCatching {
+                webView.stopLoading()
+                webView.destroy()
+            }
+        }
+        cached = null
+        cachedSessionKey = Int.MIN_VALUE
+        cachedHost = null
+    }
+
+    private fun installWatcher(context: Context) {
+        if (watcherInstalled) return
+        val app = context.applicationContext as? Application ?: return
+        watcherInstalled = true
+        app.registerActivityLifecycleCallbacks(object : Application.ActivityLifecycleCallbacks {
+            override fun onActivityDestroyed(activity: Activity) {
+                // 只认持有 WebView 的那个宿主；用 acquire 时记下的身份比对（见类型 KDoc）
+                if (cachedHost?.get() === activity) destroy()
+            }
+
+            override fun onActivityCreated(activity: Activity, savedInstanceState: Bundle?) {}
+            override fun onActivityStarted(activity: Activity) {}
+            override fun onActivityResumed(activity: Activity) {}
+            override fun onActivityPaused(activity: Activity) {}
+            override fun onActivityStopped(activity: Activity) {}
+            override fun onActivitySaveInstanceState(activity: Activity, outState: Bundle) {}
+        })
+    }
+}
+
+/**
+ * 回到面板首页（入口项）——「重进总是面板首页」，但**不能**整页 `loadUrl`（那是白闪本体）。
+ *
+ * 按**历史深度**回退 `history.go(-currentIndex)`：一步退回会话的第一个真实入口项，
+ * SPA 走 popstate 把路由切回首页，不重新下载、不白闪、卡片在内存里原样在。
+ * 不做 URL 精确匹配——面板服务器的重定向（`…/ui` → `…/ui/`、补 `#/`）会让入口项的
+ * 实际 URL 和配置串对不上，匹配一失败就退化成整页重载（上一版闪烁的另一半原因）。
+ * 跳过开头可能残留的 `about:blank` 项；已经在入口项时直接返回。
+ */
+internal fun WebView.goHome() {
+    val list = copyBackForwardList()
+    val cur = list.currentIndex
+    if (cur <= 0) return
+    var homeIdx = 0
+    while (homeIdx < cur && (list.getItemAtIndex(homeIdx)?.url ?: "about:blank") == "about:blank") {
+        homeIdx++
+    }
+    if (homeIdx >= cur) return
+    evaluateJavascript("history.go(${homeIdx - cur});", null)
+}
+
+/**
+ * 外部面板用的 WebView（box.app `ThemedWebView` 的 Mishka 版）。
+ *
+ * 几件容易被忽略但必须有的事：
+ *  1. **mixedContentMode 必须放开**：面板多为 https 站点（metacubexd 等），而控制器在
+ *     `http://127.0.0.1:<port>`，WebView 默认的 `MIXED_CONTENT_NEVER_ALLOW` 会直接掐掉
+ *     面板调 API 的请求，表现为「页面能开、数据全空」且只在 logcat 里留一行。
+ *  2. **[sessionKey] 变了要重建 WebView**：切面板只 `loadUrl` 会保留上一个面板的
+ *     history 与 JS 全局状态，`key()` 包一层让 Compose 整个换掉实例。
+ *  3. **文本缩放锁 100**：不锁的话系统字体放大后桌面端面板布局会溢出。
+ *  4. **返回进入语义对齐 box.app，但重进不整页重载**：进入总是面板首页，返回先退页内
+ *     历史（[backRequestKey] → `goBack`），退无可退由宿主退出页面。实现上 WebView 实例
+ *     跨「返回 / 重进」保留（[PanelWebViewCache]）——整页重载正是「闪烁 + 卡片缺失」的
+ *     根源（box.app 每次进入重新 load，两个症状它同样躲不掉）；重进用 [goHome] 按历史
+ *     深度回退到入口项（SPA popstate 切回首页，**不整页重载**）。新实例由 [WebViewPreloader]
+ *     秒建；换 [url] 加载完清 history（box.app `resetHistoryOnUrlChange`），
+ *     返回不会走进上一个面板的历史。
+ *
+ * @param reloadKey 自增即触发一次 `reload()`
+ * @param sessionKey 自增即销毁重建 WebView（切面板时用）
+ * @param backRequestKey 自增即 `goBack()`（供返回手势回调）
+ */
+@SuppressLint("SetJavaScriptEnabled")
+@Composable
+fun PanelWebView(
+    url: String,
+    isDark: Boolean,
+    reloadKey: Int,
+    sessionKey: Int,
+    backRequestKey: Int,
+    modifier: Modifier = Modifier,
+    onPageFinished: ((String?) -> Unit)? = null,
+    onTitleChange: ((String?) -> Unit)? = null,
+    onWebError: ((String?) -> Unit)? = null,
+    onCanGoBackChange: ((Boolean) -> Unit)? = null,
+) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+
+    val cookieManager = remember { CookieManager.getInstance() }
+    DisposableEffect(cookieManager) {
+        onDispose { runCatching { cookieManager.flush() } }
+    }
+
+    // 回调包一层 rememberUpdatedState：WebViewClient / WebChromeClient 只在 factory 里挂一次，
+    // 直接闭包捕获的话屏幕重组后就一直调的是首帧那批 lambda（拿到的都是旧快照）
+    // 这两条是 app 自己的提示，跟 WebView 报的英文错误混在一起显示，所以必须跟着系统语言
+    val currentSaveFailed = rememberUpdatedState(stringResource(R.string.panel_save_failed))
+    val currentNoFilePicker = rememberUpdatedState(stringResource(R.string.panel_no_file_picker))
+    val currentOnPageFinished = rememberUpdatedState(onPageFinished)
+    val currentOnTitleChange = rememberUpdatedState(onTitleChange)
+    val currentOnWebError = rememberUpdatedState(onWebError)
+    val currentOnCanGoBack = rememberUpdatedState(onCanGoBackChange)
+
+    // SAF 存盘的一次性中转：launcher 回调拿不到别的状态，只能先挂这里
+    var pendingBytes by remember { mutableStateOf<Triple<String, String, ByteArray>?>(null) }
+    var pendingDownload by remember { mutableStateOf<PendingDownload?>(null) }
+    var pendingFileCallback by remember { mutableStateOf<ValueCallback<Array<Uri>>?>(null) }
+
+    val saveLauncher = rememberLauncherForActivityResult(ActivityResultContracts.StartActivityForResult()) { result ->
+        val outUri = result.data?.data
+        val bytes = pendingBytes
+        val download = pendingDownload
+        pendingBytes = null
+        pendingDownload = null
+        if (outUri == null) return@rememberLauncherForActivityResult
+        scope.launch {
+            val ok = runCatching {
+                withContext(Dispatchers.IO) {
+                    when {
+                        bytes != null -> {
+                            context.contentResolver.openOutputStream(outUri)?.use { it.write(bytes.third) }
+                                ?: error("openOutputStream failed")
+                        }
+                        download != null -> {
+                            val conn = URL(download.url).openConnection() as HttpURLConnection
+                            conn.requestMethod = "GET"
+                            conn.setRequestProperty("User-Agent", download.userAgent)
+                            if (!download.cookie.isNullOrBlank()) conn.setRequestProperty("Cookie", download.cookie)
+                            if (download.referer.isNotBlank()) conn.setRequestProperty("Referer", download.referer)
+                            conn.connect()
+                            conn.inputStream.use { input ->
+                                context.contentResolver.openOutputStream(outUri)?.use { output ->
+                                    input.copyTo(output)
+                                } ?: error("openOutputStream failed")
+                            }
+                            conn.disconnect()
+                        }
+                    }
+                }
+            }.isSuccess
+            if (!ok) currentOnWebError.value?.invoke(currentSaveFailed.value)
+        }
+    }
+
+    val filePickerLauncher = rememberLauncherForActivityResult(ActivityResultContracts.StartActivityForResult()) { result ->
+        val callback = pendingFileCallback
+        pendingFileCallback = null
+        if (callback == null) return@rememberLauncherForActivityResult
+        val uris = ArrayList<Uri>()
+        val clip = result.data?.clipData
+        if (clip != null) {
+            for (i in 0 until clip.itemCount) clip.getItemAt(i)?.uri?.let { uris.add(it) }
+        } else {
+            result.data?.data?.let { uris.add(it) }
+        }
+        callback.onReceiveValue(uris.toTypedArray().takeIf { it.isNotEmpty() })
+    }
+
+    val jsBridge = remember {
+        object {
+            /** JS 线程回调，不在主线程；SAF 的 launch 必须切回主线程再调。 */
+            @JavascriptInterface
+            fun saveBase64File(filename: String?, mimeType: String?, base64: String?) {
+                val rawName = filename?.takeIf { it.isNotBlank() } ?: "export"
