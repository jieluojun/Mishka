+            }
+            DialogNote("多个值按列表写回；单个值保留原来的标量 / 列表形态。")
+            DialogButtons(onDismiss) {
+                val name = key.trim()
+                if (name.isEmpty()) showToast("请填写键名") else onConfirm(name, values.map(String::trim).filter(String::isNotEmpty))
+            }
+        }
+    }
+}
