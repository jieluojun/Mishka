+     */
+    fun commentIndex(line: String): Int {
+        var quote: Char? = null
+        var i = 0
+        while (i < line.length) {
+            val c = line[i]
+            if (quote != null) {
+                if (c == quote) {
+                    if (i + 1 < line.length && line[i + 1] == quote) i++ else quote = null
+                }
+            } else when (c) {
+                '"', '\'' -> quote = c
+                '#' -> if (i == 0 || line[i - 1].isWhitespace()) return i
