+private fun netOptsKey(network: String?): String? = when (network) {
+    "ws" -> "ws-opts"
+    "h2" -> "h2-opts"
+    "grpc" -> "grpc-opts"
+    "http" -> "http-opts"
+    "xhttp" -> "xhttp-opts"
+    else -> null
+}
