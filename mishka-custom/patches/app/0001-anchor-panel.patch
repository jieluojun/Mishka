+            defs.filter { it.line1 < headLine1 && it.isMap }.map { FormOption(it.name, it.name) }
+        OptionPickerDialog(
+            title = "继承锚点",
+            summary = "只列定义在本条目之前、且是映射的锚点；选「(不继承)」删除 <<: 行",
+            options = options,
