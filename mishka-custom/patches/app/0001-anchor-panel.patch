+/** 新建时的校验模板：只要不是 Scalar/Unknown，形状与新建块一致（顶层键 + 缩进两格的映射）。 */
+private val CreateTemplate = DefBlock(
+    name = "",
+    keyDisplay = "",
+    keyRaw = "",
+    indent = 0,
+    dash = false,
+    kind = DefKind.Map,
+    headerValue = "",
+    headerComment = "",
+    entries = emptyList(),
+    lines = emptyList(),
+    startLine1 = 1,
+    path = "",
+)
