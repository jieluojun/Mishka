+            }
+            DialogNote(if (field.arrayValues) "值会按列表写入（`Key: [a, b]`）；整张表一起写回" else "值是数字 / true / false 时按原类型写入；整张表一起写回")
+            DialogButtons(onDismiss = onDismiss) {
+                val out = LinkedHashMap<String, Any?>()
+                for (i in keys.indices) {
