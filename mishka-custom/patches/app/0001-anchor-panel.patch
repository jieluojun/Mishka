+    enum class Kind { MAP, SEQ, SCALAR, RAW }
+
+    val entries = ArrayList<YamlEntry>()
+    val items = ArrayList<YamlNode>()
+}
+
+class YamlEntry(
+    val key: String,
+    val keyIndent: Int,
+    val node: YamlNode?,
+    val line: Int,
+) {
+    val isMerge: Boolean get() = key == "<<"
+}
