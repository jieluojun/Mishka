+/** fake-ip-filter：rule 模式为结构化四件套，blacklist / whitelist 保持域名文本列表。 */
+@Composable
+internal fun FakeIpRulesDialog(
+    field: FormField,
+    current: List<String>,
+    mode: String,
+    onDismiss: () -> Unit,
+    onConfirm: (List<String>) -> Unit,
+) {
+    if (!mode.equals("rule", ignoreCase = true)) {
+        ListDialog(
+            field = field,
+            current = current,
