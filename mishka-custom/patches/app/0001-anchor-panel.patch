+                        (if (hcHas && !hcLocal) " · 值来自锚点继承，改动会写穿到锚点定义"
+                        else " · 选「默认（不覆写）」将删除整个 health-check 配置块"),
+                    onClick = { hcPick = true },
+                    endActions = { TextButton(text = "选择", onClick = { hcPick = true }) },
+                )
+                "override-expr" -> {
