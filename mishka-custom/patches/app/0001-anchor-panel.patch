+
+/**
+ * 外部面板：应用内 WebView 打开内核 `external-ui` 提供的网页控制台（zashboard 等）。
+ *
+ * 地址由 [externalPanelUrl] 从运行态的 external-controller 推导（`/ui` 是 mihomo
+ * `external-ui-name` 的缺省挂载路径）。内核没在跑、或配置里没有 external-ui 时加载会失败，
+ * 页面中央给一句可操作的提示而不是白屏。
+ *
+ * 顶栏 Info 按钮打开诊断抽屉：环形缓冲记录 console / 网络错误 / 页面事件，并在页面加载后
+ * 注入 [PROBE_JS] 量取面板关键布局量（根容器高度、虚拟列表可视高度、代理卡片数、底栏几何），
+ * 用于定位"顶栏渲染但列表区空白"这类 WebView 渲染差异；同抽屉提供"浏览器打开"兜底入口。
+ *
+ * 针对「系统浏览器同址完整、app 内 WebView 空白」的残留差异（条目 28，r4）另加三条缓释：
+ * 本地面板禁 WebView HTTP 缓存（[WebSettings.LOAD_NO_CACHE]，避免坏缓存副本持续复现）；
+ * 等到第一次非零布局再 [WebView.loadUrl]（Compose interop 首帧前 innerHeight 可能为 0，
+ * 虚拟列表按 0 量行且不再重算）；首帧后与高度变化时补发 resize/scroll（[nudgeResize]）。
+ */
+@SuppressLint("SetJavaScriptEnabled")
+@Composable
+fun ExternalPanelScreen(
+    url: String,
+    onBack: () -> Unit = {},
+) {
+    val scrollBehavior = MiuixScrollBehavior()
+    val backdrop = rememberBlurBackdrop()
+    val blurActive = backdrop != null
+    val barColor = if (blurActive) Color.Transparent else MiuixTheme.colorScheme.surface
+
+    var webView by remember { mutableStateOf<WebView?>(null) }
+    // 系统返回优先在面板里回退历史，退无可退才离开页面
+    BackHandler {
+        val current = webView
+        if (current?.canGoBack() == true) current.goBack() else onBack()
+    }
+
+    var failed by remember(url) { mutableStateOf(false) }
+    var showDiag by remember { mutableStateOf(false) }
+    val diag = remember { PanelDiagLog() }
+    val context = LocalContext.current
+    val clipboard = LocalClipboardManager.current
+
+    Scaffold(
+        topBar = {
+            BlurredBar(backdrop = backdrop, blurActive = blurActive) {
+                AdaptiveTopAppBar(
+                    title = stringResource(R.string.home_external_panel),
+                    color = barColor,
+                    scrollBehavior = scrollBehavior,
+                    navigationIcon = {
+                        IconButton(onClick = onBack) {
+                            val layoutDirection = LocalLayoutDirection.current
+                            Icon(
+                                imageVector = MiuixIcons.Back,
+                                contentDescription = stringResource(R.string.common_back),
+                                tint = MiuixTheme.colorScheme.onSurface,
+                                modifier = Modifier.graphicsLayer {
+                                    scaleX = if (layoutDirection == LayoutDirection.Rtl) -1f else 1f
+                                },
+                            )
+                        }
+                    },
+                    actions = {
+                        IconButton(onClick = { showDiag = true }) {
+                            Icon(
+                                imageVector = MiuixIcons.Info,
+                                contentDescription = stringResource(R.string.external_panel_diag_title),
+                                tint = MiuixTheme.colorScheme.onSurface,
+                            )
+                        }
+                    },
+                )
+            }
+        },
+    ) { innerPadding ->
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(top = innerPadding.calculateTopPadding()),
+        ) {
+            AndroidView(
+                factory = { ctx ->
+                    var loadedOnce = false
+                    WebView(ctx).apply {
+                        // 面板是 SPA：JS 与 localStorage 都是硬需求
+                        settings.javaScriptEnabled = true
+                        settings.domStorageEnabled = true
+                        // 面板伺服在本机内核上、带宽不是约束；WebView 的 HTTP 缓存一旦存过
+                        // 坏副本（早期 404/半截 chunk）就会持续复现「顶栏在、列表空」，
+                        // 系统浏览器因缓存独立而表现正常——对本地 UI 直接禁缓存最稳
+                        settings.cacheMode = WebSettings.LOAD_NO_CACHE
+                        webChromeClient = object : WebChromeClient() {
+                            override fun onConsoleMessage(message: ConsoleMessage?): Boolean {
+                                message?.let {
+                                    diag.add("[console:${it.messageLevel()}] ${it.message()} @${it.sourceId()}:${it.lineNumber()}")
+                                }
+                                return true
+                            }
+                        }
+                        webViewClient = object : WebViewClient() {
+                            override fun onPageStarted(view: WebView?, url: String?, favicon: android.graphics.Bitmap?) {
+                                failed = false
+                                diag.add("[page] started $url")
+                            }
+
+                            override fun onReceivedError(
+                                view: WebView?,
+                                request: WebResourceRequest?,
+                                error: WebResourceError?,
+                            ) {
+                                // 只关心主文档：SPA 里个别子资源 404 不该把整页标成失败
+                                diag.add("[neterr main=${request?.isForMainFrame == true}] ${error?.errorCode} ${error?.description} ${request?.url}")
+                                if (request?.isForMainFrame == true) failed = true
+                            }
+
+                            override fun onReceivedHttpError(
+                                view: WebView?,
+                                request: WebResourceRequest?,
+                                errorResponse: WebResourceResponse?,
+                            ) {
+                                // HTTP 4xx/5xx 不触发 onReceivedError（那个只报网络层错误）。
+                                // 典型场景：内核没启用 external-ui 时 /ui 返回 404 text/plain，
+                                // WebView 渲染出来就是一片空白——不补这个回调，用户只会看到白屏
+                                diag.add("[httperr ${errorResponse?.statusCode} main=${request?.isForMainFrame == true}] ${request?.url}")
+                                if (request?.isForMainFrame == true) failed = true
+                            }
+
+                            override fun onPageFinished(view: WebView?, url: String?) {
+                                diag.add("[page] finished $url")
+                                // 首帧后补一次 resize/scroll：虚拟列表/底栏若按 0 高度挂载可借此重算
+                                view?.postDelayed({ nudgeResize(view, diag) }, 600)
+                                // 面板是异步渲染：首帧后虚拟列表/底栏才挂载，延迟两次取样
+                                view?.postDelayed({ runProbe(view, diag, 1) }, 2500)
+                                view?.postDelayed({ runProbe(view, diag, 2) }, 8000)
+                            }
+                        }
+                        // Compose interop：factory 时刻 view 还没参与布局，innerHeight 可能为 0；
+                        // 面板的虚拟列表若在此刻量可视行数会得到 0 且不再重算（系统浏览器首帧
+                        // 布局即正确，故同址表现正常）。等到第一次非零布局再加载，并在高度
+                        // 变化后补发 resize/scroll 事件触发虚拟列表与底栏重算
+                        addOnLayoutChangeListener(object : View.OnLayoutChangeListener {
+                            private var lastH = -1
+                            override fun onLayoutChange(
+                                v: View,
+                                left: Int, top: Int, right: Int, bottom: Int,
+                                oldLeft: Int, oldTop: Int, oldRight: Int, oldBottom: Int,
+                            ) {
+                                if (v.width == 0 || v.height == 0) return
+                                if (!loadedOnce) {
+                                    loadedOnce = true
+                                    lastH = v.height
+                                    diag.add("[layout] first non-zero ${v.width}x${v.height}, loading")
+                                    v.post { loadUrl(url) }
+                                    return
+                                }
+                                if (v.height != lastH) {
+                                    lastH = v.height
+                                    v.post { nudgeResize(this@apply, diag) }
+                                }
+                            }
+                        })
+                        webView = this
+                    }
+                },
+                onRelease = { view ->
+                    webView = null
+                    view.destroy()
+                },
+                modifier = Modifier.fillMaxSize(),
+            )
+            if (failed) {
+                Text(
+                    text = stringResource(R.string.external_panel_load_failed),
+                    fontSize = 13.sp,
+                    color = MiuixTheme.colorScheme.onSurfaceVariantSummary,
+                    modifier = Modifier
+                        .align(Alignment.Center)
+                        .padding(horizontal = 32.dp),
+                )
+            }
+        }
+    }
+
+    if (showDiag) {
+        Dialog(onDismissRequest = { showDiag = false }) {
+            Column(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .heightIn(max = 560.dp)
+                    .background(MiuixTheme.colorScheme.surface, RoundedCornerShape(20.dp))
+                    .padding(16.dp),
+            ) {
+                Text(
+                    text = stringResource(R.string.external_panel_diag_title),
+                    fontSize = 16.sp,
+                    color = MiuixTheme.colorScheme.onSurface,
+                )
+                SelectionContainer(
+                    modifier = Modifier
+                        .weight(1f, fill = false)
+                        .heightIn(max = 420.dp)
+                        .padding(top = 8.dp)
+                        .fillMaxWidth()
+                        .verticalScroll(rememberScrollState()),
+                ) {
+                    Text(
+                        text = diag.text(),
+                        fontSize = 11.sp,
+                        color = MiuixTheme.colorScheme.onSurfaceVariantSummary,
+                    )
+                }
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(top = 12.dp),
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    TextButton(
+                        text = stringResource(R.string.external_panel_diag_copy),
+                        modifier = Modifier.weight(1f),
+                        onClick = { clipboard.setText(AnnotatedString(diag.text())) },
+                    )
+                    TextButton(
+                        text = stringResource(R.string.external_panel_diag_open_browser),
+                        modifier = Modifier.weight(1f),
+                        onClick = {
+                            runCatching {
+                                context.startActivity(
+                                    Intent(Intent.ACTION_VIEW, Uri.parse(url)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+                                )
+                            }
+                        },
+                    )
+                    TextButton(
+                        text = stringResource(R.string.external_panel_diag_close),
+                        modifier = Modifier.weight(1f),
+                        onClick = { showDiag = false },
+                    )
+                }
+            }
+        }
+    }
+}
+
+/** 补发 resize/scroll：WebView 视口尺寸变化不一定触发 window 事件，虚拟列表可能停在 0 行。 */
+private fun nudgeResize(view: WebView?, diag: PanelDiagLog) {
+    runCatching {
+        view?.evaluateJavascript(
+            "window.dispatchEvent(new Event('resize'));window.dispatchEvent(new Event('scroll'));'nudged'",
+        ) { diag.add("[nudge] $it") }
+    }
+}
+
+/** 在面板页面里量取关键布局量：区分"高度链塌陷 / 虚拟列表零行 / 纯绘制问题"。 */
+private fun runProbe(view: WebView, diag: PanelDiagLog, round: Int) {
+    runCatching {
+        view.evaluateJavascript(PROBE_JS) { result ->
+            diag.add("[probe#$round] $result")
+        }
+    }
+}
+
+/**
+ * 探针只读不写：根容器（`.h-dvh`）高度、页面滚动容器高度、虚拟列表行（`.proxy-group-card`）
+ * 数量与首行 top、底栏（`.tab-bar`）几何、dvh 支持度、localStorage 可用性、UA/引擎版本。
+ */
+private val PROBE_JS = """
+(function(){
+  function r(s){return document.querySelector(s)}
+  function rect(e){if(!e)return null;var b=e.getBoundingClientRect();return {t:Math.round(b.top),h:Math.round(b.height),w:Math.round(b.width)}}
+  var root=r('.h-dvh');
+  var scroller=r('.h-dvh .overflow-y-auto');
+  var cards=document.querySelectorAll('.proxy-group-card');
+  var nav=r('.tab-bar');
+  var ls=(function(){try{localStorage.setItem('__mishka_t','1');localStorage.removeItem('__mishka_t');return 'ok'}catch(e){return 'ERR:'+e.name}})();
+  var m=(navigator.userAgent.match(/Chrome\/([0-9.]+)/)||[])[1]||'?';
+  return JSON.stringify({
+    chrome:m, ls:ls, iw:innerWidth, ih:innerHeight,
+    root:rect(root), rootCssH:root?getComputedStyle(root).height:null,
+    scroller:rect(scroller), scrollerCssH:scroller?getComputedStyle(scroller).height:null,
+    cards:cards.length, card0:rect(cards[0]), card0Top:cards[0]?cards[0].style.top:null,
+    nav:rect(nav), navPos:nav?getComputedStyle(nav).position:null, navBottom:nav?getComputedStyle(nav).bottom:null,
+    dvh:CSS.supports('height','100dvh'), oklch:CSS.supports('color','oklch(0.5 0.1 100)'),
+    has:CSS.supports('selector(:has(*))'), bodyH:document.body.clientHeight
+  })
+})()
+""".trimIndent()
+
+/** 诊断环形缓冲：最多保留 [CAP] 行，跨线程安全（WebView 回调在 IO/主线程都可能到来）。 */
+class PanelDiagLog {
+    private val buf = ArrayDeque<String>(CAP)
+    private val lock = Any()
+
+    fun add(line: String) {
+        synchronized(lock) {
+            if (buf.size >= CAP) buf.removeFirst()
+            buf.addLast(line)
+        }
+    }
+
+    fun text(): String = synchronized(lock) { buf.joinToString("\n") }
+
+    private companion object {
+        const val CAP = 240
+    }
+}
+
+/**
+ * 运行中的 external-controller → 面板地址。`0.0.0.0` / `*` / `::` 是监听通配地址、不可连接，
+ * 换成本机回环；缺省端口按 mihomo 惯例不补（配置里 host:port 一体）。
+ *
+ * 两个必须遵守的实测约束：
+ * - **尾部斜杠**：内核对 `/ui`（无斜杠）回 307 重定向，`Location: /ui/` 会丢掉全部
+ *   query 参数，面板拿不到 host/secret 就会停在手动设置页。
+ * - **自动登录参数**：zashboard 的 URL 契约是 `?hostname=&port=&secret=`（gate 参数是
+ *   `hostname`，缺失时返回 null → 手动设置页；没有 `host`/`token` 兼容分支）。
+ */
+fun externalPanelUrl(externalController: String, secret: String = ""): String {
+    val raw = externalController.trim()
+        .removePrefix("http://")
+        .removePrefix("https://")
+        .substringBefore('/')
+    val host = raw.substringBeforeLast(':').ifEmpty { "127.0.0.1" }
+    val port = raw.substringAfterLast(':', "")
+    val reachableHost = if (host == "0.0.0.0" || host == "*" || host == "::" || host == "[::]") {
+        "127.0.0.1"
+    } else {
+        host
+    }
+    val base = if (port.isEmpty()) "http://$reachableHost/ui/" else "http://$reachableHost:$port/ui/"
+    val params = buildString {
+        append("?hostname=").append(Uri.encode(reachableHost))
+        if (port.isNotEmpty()) append("&port=").append(Uri.encode(port))
+        if (secret.isNotEmpty()) append("&secret=").append(Uri.encode(secret))
+    }
+    return base + params
+}
