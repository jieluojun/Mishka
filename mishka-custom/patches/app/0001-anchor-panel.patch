+    if (plainDelete >= 0) {
+        val i = plainDelete
+        ConfirmDialog(
+            title = "删除代理组",
+            text = "删除 `${pathText(GROUPS_PATH + i)}`（没有名字，无法检查引用）？这个操作只能靠编辑器撤销。",
+            confirmLabel = "删除",
+            onDismiss = { plainDelete = -1 },
+            onConfirm = { plainDelete = -1; host.removeItem(GROUPS_PATH, i, "代理组 #${i + 1}") },
+        )
+    }
