+                    .verticalScroll(rememberScrollState()),
+            ) {
+                for (index in rows.indices) {
+                    Row(
+                        modifier = Modifier.fillMaxWidth().padding(vertical = 2.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                    ) {
+                        for ((ci, col) in columns.withIndex()) {
