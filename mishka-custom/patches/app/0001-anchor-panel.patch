+@Composable
+private fun TunnelDetailPage(host: FormHost, nav: FormNav, index: Int) {
+    val doc = host.doc
+    val base: YPath = TUNNELS_PATH + index
+    val node = doc.get(base)
+    if (node == null) {
+        MissingItem("这条隧道已经不在了")
