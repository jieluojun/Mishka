+private data class PanelProxyResolution(
+    val known: Boolean,
+    val proxyAddress: String? = null,
+)
+
+/** 从实际运行中的 mihomo /configs 读取 WebView 可用的本机 HTTP 代理端口。 */
+private suspend fun resolvePanelProxy(status: ProxyServiceStatus): PanelProxyResolution {
+    if (status.state != ProxyState.Running) return PanelProxyResolution(known = true)
+
+    return withContext(Dispatchers.IO) {
+        val client = MihomoApiClient(
+            baseUrl = "http://${status.externalController}",
+            secret = status.secret,
+        )
+        try {
+            val config = client.getConfig()
+            val proxyAddress = when {
+                config.mixedPort in 1..65535 -> "127.0.0.1:${config.mixedPort}"
+                config.port in 1..65535 -> "127.0.0.1:${config.port}"
+                config.socksPort in 1..65535 -> "socks://127.0.0.1:${config.socksPort}"
+                else -> null
+            }
+            PanelProxyResolution(known = true, proxyAddress = proxyAddress)
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            PanelProxyResolution(known = false)
+        } finally {
+            client.close()
+        }
+    }
+}
