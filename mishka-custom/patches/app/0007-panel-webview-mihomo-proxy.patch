+/**
+ * WebView 的网络栈属于 Mishka 进程，而 VpnService 会把 Mishka 自己排除在 TUN 之外。
+ * 因此只给面板 WebView 显式设置 mihomo 本机代理；不改 app 其它请求，也不把 app UID 拉回 TUN。
+ * AndroidX 的 override 是进程内所有 WebView 共用的，面板是本 app 唯一的联网 WebView。
+ */
+internal object PanelWebViewProxy {
+    private data class AppliedConfig(
+        val proxyAddress: String?,
+        val controllerHost: String?,
+    )
+
+    @Volatile
+    private var appliedConfig: AppliedConfig? = null
+
+    @Volatile
+    private var hasAppliedConfig = false
+
+    /**
+     * 将 WebView 的 HTTP(S) 流量指向 mihomo mixed-port（无 mixed-port 时由调用方传 HTTP/SOCKS 端口）。
+     * 返回 true 表示代理路径确实发生变化，调用方需要 reload 现有面板，使页面的检测请求重发。
+     */
+    suspend fun apply(proxyAddress: String?, externalController: String): Boolean =
+        withContext(Dispatchers.Main.immediate) {
+            if (!WebViewFeature.isFeatureSupported(WebViewFeature.PROXY_OVERRIDE)) return@withContext false
+
+            val controllerHost = proxyAddress?.let { parseHost(externalController) }
+            val requested = AppliedConfig(proxyAddress, controllerHost)
+            if (hasAppliedConfig && appliedConfig == requested) return@withContext false
+
+            val previous = appliedConfig
+            val wasConfigured = hasAppliedConfig
+            val routeChanged = wasConfigured && previous != requested
+
+            // 本进程刚启动且无需代理：AndroidX override 尚未设置，保持 WebView 系统默认行为即可。
+            if (proxyAddress == null && !wasConfigured) {
+                appliedConfig = requested
+                hasAppliedConfig = true
+                return@withContext false
+            }
+
+            suspendCancellableCoroutine<Boolean> { continuation ->
+                val executor = Executor { command ->
+                    Handler(Looper.getMainLooper()).post(command)
+                }
+                val controller = ProxyController.getInstance()
+                val complete = Runnable {
+                    appliedConfig = requested
+                    hasAppliedConfig = true
+                    if (continuation.isActive) continuation.resume(routeChanged)
+                }
+                try {
+                    if (proxyAddress == null) {
+                        controller.clearProxyOverride(executor, complete)
+                    } else {
+                        val proxyConfig = ProxyConfig.Builder()
+                            .addProxyRule(proxyAddress)
+                            // mihomo 控制器必须直连；loopback 默认也由 WebView 隐式绕过，显式列出
+                            // 是为了兼容厂商 WebView 对隐式 bypass 列表的差异。
+                            .addBypassRule("localhost")
+                            .addBypassRule("*.localhost")
+                            .addBypassRule("127.*")
+                            .addBypassRule("[::1]")
+                            .apply {
+                                controllerHost
+                                    ?.takeUnless { it == "localhost" || it == "[::1]" || it.startsWith("127.") }
+                                    ?.let { addBypassRule(it) }
+                            }
+                            .build()
+                        controller.setProxyOverride(proxyConfig, executor, complete)
+                    }
+                } catch (_: Exception) {
+                    // 设置失败时尽量清掉旧代理，避免端口变更后 WebView 仍指向已失效的监听端口。
+                    val direct = AppliedConfig(proxyAddress = null, controllerHost = null)
+                    val fallback = Runnable {
+                        appliedConfig = direct
+                        hasAppliedConfig = true
+                        if (continuation.isActive) continuation.resume(wasConfigured && previous?.proxyAddress != null)
+                    }
+                    runCatching { controller.clearProxyOverride(executor, fallback) }
+                        .onFailure {
+                            appliedConfig = direct
+                            hasAppliedConfig = true
+                            if (continuation.isActive) continuation.resume(wasConfigured && previous?.proxyAddress != null)
+                        }
+                }
+            }
+        }
+
+    private fun parseHost(address: String): String? {
+        val host = Uri.parse("http://$address").host?.trim().orEmpty()
+        if (host.isBlank()) return null
+        return if (':' in host && !host.startsWith("[")) "[$host]" else host
+    }
+}
 
